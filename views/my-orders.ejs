<%- include('partials/header', { title: 'Meus Pedidos' }) %>

<section class="section orders-section">
  <div class="container">
    <h1>Meus Pedidos</h1>
    
    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-box-open"></i>
        <h3>Nenhum pedido ainda</h3>
        <p>Você ainda não fez nenhum pedido. Que tal conferir nossos produtos?</p>
        <a href="/" class="btn btn-primary">Ver Produtos</a>
      </div>
    <% } else { %>
      <div class="orders-list">
        <% orders.forEach(order => { %>
          <a href="/confirmation/<%= order.id %>" class="order-card">
            <div class="order-card-header">
              <span class="order-id">Pedido #<%= order.id %></span>
              <span class="order-status status-<%= order.status %>">
                <%= order.status === 'pending' ? 'Aguardando' : 
                    order.status === 'confirmed' ? 'Confirmado' :
                    order.status === 'printing' ? 'Imprimindo' :
                    order.status === 'shipped' ? 'Enviado' :
                    order.status === 'delivered' ? 'Entregue' : 'Cancelado' %>
              </span>
            </div>
            <div class="order-card-body">
              <span><i class="fas fa-box"></i> <%= order.total_items %> itens</span>
              <span class="order-total">R$ <%= order.total.toFixed(2).replace('.', ',') %></span>
            </div>
            <div class="order-card-footer">
              <i class="fas fa-calendar"></i> <%= new Date(order.created_at).toLocaleString('pt-BR') %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
