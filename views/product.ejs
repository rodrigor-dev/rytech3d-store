<%- include('partials/header', { title: product.name }) %>

<section class="section product-detail-section">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Início</a> / <a href="/#produtos">Produtos</a> / <span><%= product.name %></span>
    </nav>

    <div class="product-detail">
      <div class="product-detail-image">
        <div class="product-video-main" id="productVideoMain" style="<%= product.main_media === 'video' && product.video_url ? '' : 'display:none' %>">
          <div class="video-container">
            <% if (product.video_url && (product.video_url.includes('youtube') || product.video_url.includes('youtu.be'))) { %>
              <iframe src="<%= product.video_url.replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/') %>" frameborder="0" allowfullscreen></iframe>
            <% } else if (product.video_url) { %>
              <video controls class="product-video-player" <%= product.main_media === 'video' ? 'autoplay muted playsinline' : 'preload="none"' %> poster="<%= product.image_url %>">
                <source src="<%= product.video_url %>" type="<%= product.video_mime || 'video/mp4' %>">
                Seu navegador não suporta vídeo HTML5.
              </video>
            <% } %>
          </div>
        </div>
        <div class="product-image-main" id="mainImageContainer" style="<%= product.main_media === 'video' && product.video_url ? 'display:none' : '' %>">
          <img id="mainProductImage" src="<%= product.image_url %>" alt="<%= product.name %>" onerror="this.src='/uploads/products/default.svg'">
          <% if (product.main_media === 'video' && product.video_url) { %>
          <button class="btn btn-small btn-outline" id="showVideoBtn" onclick="showVideo()" style="margin-top:8px">
            <i class="fas fa-video"></i> Ver Vídeo
          </button>
          <% } %>
        </div>
        <div class="product-thumbnails" id="productThumbnails">
          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="thumb active" onclick="changeImage(this.src)" onerror="this.src='/uploads/products/default.svg'">
          <% if (product.extraImages) { product.extraImages.forEach(img => { %>
            <img src="<%= img.image_url %>" alt="<%= product.name %>" class="thumb" onclick="changeImage(this.src)" onerror="this.src='/uploads/products/default.svg'">
          <% }) } %>
        </div>
      </div>
      <div class="product-detail-info">
        <span class="product-category"><%= product.category %></span>
        <h1 class="product-detail-title"><%= product.name %></h1>
        <div class="product-detail-price">
          <span class="price-current">R$ <%= product.price.toFixed(2).replace('.', ',') %></span>
        </div>
        <div class="product-detail-meta">
          <div class="meta-item">
            <i class="fas fa-clock"></i>
            <div>
              <strong>Prazo de Entrega</strong>
              <span><%= product.delivery_time %></span>
            </div>
          </div>
          <div class="meta-item">
            <i class="fas fa-box"></i>
            <div>
              <strong>Feito sob encomenda</strong>
              <span>Produzido após a confirmação do pedido</span>
            </div>
          </div>
          <div class="meta-item">
            <i class="fas fa-ruler-combined"></i>
            <div>
              <strong>Personalizável</strong>
              <span>Entre em contato para personalizar</span>
            </div>
          </div>
        </div>
        <div class="product-detail-actions">
          <div class="quantity-selector">
            <button class="qty-btn" onclick="changeQty(-1)">-</button>
            <input type="number" id="productQty" value="1" min="1" max="99">
            <button class="qty-btn" onclick="changeQty(1)">+</button>
          </div>
          <% if (typeof variations !== 'undefined' && variations && variations.length > 0) { %>
            <div class="product-variations">
              <% 
                const grouped = {};
                variations.forEach(v => {
                  if (!grouped[v.group_name]) grouped[v.group_name] = [];
                  grouped[v.group_name].push(v);
                });
                const groupNames = Object.keys(grouped);
              %>
              <% groupNames.forEach(groupName => { %>
                <div class="variation-group">
                  <label class="variation-label"><%= groupName %></label>
                  <div class="variation-options">
                    <% grouped[groupName].forEach((v, idx) => { %>
                      <label class="variation-option">
                        <input type="radio" name="var_<%= groupName.toLowerCase() %>" value="<%= v.variation_name %>" data-price="<%= v.price_modifier %>" onchange="updateVariationPrice(); checkVariations()">
                        <span><%= v.variation_name %><% if (v.price_modifier > 0) { %> <small>+R$ <%= v.price_modifier.toFixed(2).replace('.', ',') %></small><% } %></span>
                      </label>
              <% }) %>
            </div>
          </div>
        <% }) %>
            <div id="variationRequiredMsg" style="display:none;color:var(--accent);font-size:0.8rem;margin-top:4px"><i class="fas fa-exclamation-circle"></i> Selecione uma opção para continuar</div>
            </div>
          <% } %>
          <button class="btn btn-primary btn-lg add-to-cart-btn" 
            data-id="<%= product.id %>" 
            data-name="<%= product.name %>" 
            data-price="<%= product.price %>" 
            data-image="<%= product.image_url %>"
            <%= typeof variations !== 'undefined' && variations && variations.length > 0 ? 'disabled' : '' %>
            onclick="addWithQty(this)">
            <i class="fas fa-cart-plus"></i> Adicionar ao Carrinho
          </button>
        </div>
        <div class="product-detail-whatsapp">
          <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=Olá! Tenho interesse no produto: <%= encodeURIComponent(product.name) %> (R$ <%= product.price.toFixed(2) %>)" target="_blank" class="btn btn-outline whatsapp-btn">
            <i class="fab fa-whatsapp"></i> Tirar Dúvidas no WhatsApp
          </a>
        </div>
        <div class="product-detail-desc">
          <h3>Descrição</h3>
          <p><%= product.description %></p>
        </div>
      </div>
    </div>

    <% if (product.video_url && product.main_media !== 'video') { %>
    <div class="product-video">
      <h2 class="section-title">Vídeo do Produto</h2>
      <div class="video-container">
        <% if (product.video_url.includes('youtube') || product.video_url.includes('youtu.be')) { %>
          <iframe src="<%= product.video_url.replace('watch?v=', 'embed/').replace('youtu.be/', 'youtube.com/embed/') %>" frameborder="0" allowfullscreen></iframe>
        <% } else { %>
          <video controls class="product-video-player" preload="none" poster="<%= product.image_url %>">
            <source src="<%= product.video_url %>" type="<%= product.video_mime || 'video/mp4' %>">
            Seu navegador não suporta vídeo HTML5.
          </video>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (relatedProducts.length > 0) { %>
    <div class="related-products">
      <h2 class="section-title">Produtos Relacionados</h2>
      <div class="products-grid">
        <% relatedProducts.forEach(p => { %>
          <div class="product-card">
            <div class="product-image">
              <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/uploads/products/default.svg'">
              <div class="product-overlay">
                <a href="/product/<%= p.id %>" class="btn btn-small btn-primary"><i class="fas fa-eye"></i> Detalhes</a>
                <button class="btn btn-small btn-accent add-to-cart-btn" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-image="<%= p.image_url %>">
                  <i class="fas fa-cart-plus"></i>
                </button>
              </div>
            </div>
            <div class="product-info">
              <span class="product-category"><%= p.category %></span>
              <h3 class="product-name"><%= p.name %></h3>
              <div class="product-footer">
                <span class="product-price">R$ <%= p.price.toFixed(2).replace('.', ',') %></span>
                <button class="btn btn-sm btn-primary add-to-cart-btn" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-image="<%= p.image_url %>">
                  <i class="fas fa-cart-plus"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script>
function changeImage(src) {
  var mainImg = document.getElementById('mainProductImage');
  if (mainImg) mainImg.src = src;
  var videoMain = document.getElementById('productVideoMain');
  var imgContainer = document.getElementById('mainImageContainer');
  var showBtn = document.getElementById('showVideoBtn');
  if (videoMain && imgContainer) {
    videoMain.style.display = 'none';
    imgContainer.style.display = '';
    if (showBtn) showBtn.style.display = '';
  }
  document.querySelectorAll('.thumb').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.thumb').forEach(function(t) { if (t.src === src) t.classList.add('active'); });
}

function showVideo() {
  document.getElementById('productVideoMain').style.display = '';
  document.getElementById('mainImageContainer').style.display = 'none';
  var showBtn = document.getElementById('showVideoBtn');
  if (showBtn) showBtn.style.display = 'none';
  document.querySelectorAll('.thumb').forEach(function(t) { t.classList.remove('active'); });
  var firstThumb = document.querySelector('.thumb');
  if (firstThumb) firstThumb.classList.add('active');
}

function changeQty(delta) {
  const input = document.getElementById('productQty');
  let val = parseInt(input.value) || 1;
  val += delta;
  if (val < 1) val = 1;
  if (val > 99) val = 99;
  input.value = val;
}

function getSelectedVariations() {
  const vars = {};
  document.querySelectorAll('.variation-group input[type="radio"]:checked').forEach(input => {
    const name = input.name.replace('var_', '');
    vars[name] = {
      name: input.value,
      price_modifier: parseFloat(input.dataset.price) || 0
    };
  });
  return vars;
}

function checkVariations() {
  const groups = document.querySelectorAll('.variation-group');
  const btn = document.querySelector('.add-to-cart-btn');
  const msg = document.getElementById('variationRequiredMsg');
  if (!groups.length) return;
  let allSelected = true;
  groups.forEach(function(g) {
    if (!g.querySelector('input[type="radio"]:checked')) allSelected = false;
  });
  if (btn) btn.disabled = !allSelected;
  if (msg) msg.style.display = allSelected ? 'none' : '';
}

function addWithQty(btn) {
  const variations = getSelectedVariations();
  const groups = document.querySelectorAll('.variation-group');
  if (groups.length) {
    let allSelected = true;
    groups.forEach(function(g) {
      if (!g.querySelector('input[type="radio"]:checked')) allSelected = false;
    });
    if (!allSelected) {
      showToast('Selecione todas as variações obrigatórias antes de adicionar ao carrinho.');
      return;
    }
  }
  const qty = parseInt(document.getElementById('productQty').value) || 1;
  const hasVars = Object.keys(variations).length > 0;
  const basePrice = parseFloat(btn.dataset.price);
  let totalVarPrice = 0;
  Object.values(variations).forEach(v => { totalVarPrice += v.price_modifier; });
  const finalPrice = basePrice + totalVarPrice;
  
  for (let i = 0; i < qty; i++) {
    addToCart(btn.dataset.id, btn.dataset.name, finalPrice, btn.dataset.image, hasVars ? variations : null);
  }
  updateCartBadge();
  showToast(`${qty}x ${btn.dataset.name} adicionado ao carrinho!`);
}

function updateVariationPrice() {
  const basePrice = <%= product.price %>;
  let totalVar = 0;
  document.querySelectorAll('.variation-group input[type="radio"]:checked').forEach(input => {
    totalVar += parseFloat(input.dataset.price) || 0;
  });
  const total = basePrice + totalVar;
  document.querySelector('.price-current').textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
}

document.addEventListener('DOMContentLoaded', function() {
  checkVariations();
});
</script>

<style>
.product-thumbnails { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
.product-thumbnails .thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 6px; cursor: pointer; border: 2px solid transparent; transition: 0.2s; }
.product-thumbnails .thumb.active { border-color: var(--accent); }
.product-thumbnails .thumb:hover { border-color: var(--accent); }

.product-video { margin-top: 40px; }
.product-video-main { margin-bottom: 12px; }
.product-video-main .video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius); background: #000; }
.product-video-main .video-container iframe, .product-video-main .product-video-player { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.product-video-main .product-video-player { object-fit: contain; background: #000; border-radius: var(--radius); }
.video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius); background: var(--bg-card); }
.video-container iframe, .product-video-player { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.product-video-player { object-fit: contain; background: #000; border-radius: var(--radius); }

.product-variations { margin: 16px 0; width: 100%; }
.variation-group { margin-bottom: 12px; }
.variation-label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
.variation-options { display: flex; flex-wrap: wrap; gap: 8px; }
.variation-option { cursor: pointer; }
.variation-option input { display: none; }
.variation-option span { display: block; padding: 8px 16px; border: 2px solid var(--border); border-radius: var(--radius-sm); font-size: 0.85rem; transition: 0.2s; background: var(--bg-card); }
.variation-option input:checked + span { border-color: var(--accent); background: rgba(0,212,170,0.1); color: var(--accent); }
.variation-option:hover span { border-color: var(--accent); }
.variation-option small { color: var(--text-muted); font-weight: 500; }
.add-to-cart-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<%- include('partials/footer') %>
