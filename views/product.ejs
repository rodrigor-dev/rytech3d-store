<%- include('partials/header', { title: product.name }) %>

<section class="section product-detail-section">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Início</a> / <a href="/#produtos">Produtos</a> / <span><%= product.name %></span>
    </nav>

    <div class="product-detail">
      <div class="product-detail-image">
        <div class="product-image-main">
          <img src="<%= product.image_url %>" alt="<%= product.name %>" onerror="this.src='/uploads/products/default.svg'">
        </div>
      </div>
      <div class="product-detail-info">
        <span class="product-category"><%= product.category %></span>
        <h1 class="product-detail-title"><%= product.name %></h1>
        <div class="product-detail-price">
          <span class="price-current">R$ <%= product.price.toFixed(2).replace('.', ',') %></span>
        </div>
        <div class="product-detail-meta">
          <div class="meta-item">
            <i class="fas fa-clock"></i>
            <div>
              <strong>Prazo de Entrega</strong>
              <span><%= product.delivery_time %></span>
            </div>
          </div>
          <div class="meta-item">
            <i class="fas fa-box"></i>
            <div>
              <strong>Feito sob encomenda</strong>
              <span>Produzido após a confirmação do pedido</span>
            </div>
          </div>
        </div>
        <div class="product-detail-desc">
          <h3>Descrição</h3>
          <p><%= product.description %></p>
        </div>
        <div class="product-detail-actions">
          <div class="quantity-selector">
            <button class="qty-btn" onclick="changeQty(-1)">-</button>
            <input type="number" id="productQty" value="1" min="1" max="99">
            <button class="qty-btn" onclick="changeQty(1)">+</button>
          </div>
          <button class="btn btn-primary btn-lg add-to-cart-btn" 
            data-id="<%= product.id %>" 
            data-name="<%= product.name %>" 
            data-price="<%= product.price %>" 
            data-image="<%= product.image_url %>"
            onclick="addWithQty(this)">
            <i class="fas fa-cart-plus"></i> Adicionar ao Carrinho
          </button>
        </div>
        <div class="product-detail-whatsapp">
          <a href="https://wa.me/<%= typeof siteSettings !== 'undefined' && siteSettings.whatsapp_number ? siteSettings.whatsapp_number : '5562992371986' %>?text=Olá! Tenho interesse no produto: <%= encodeURIComponent(product.name) %> (R$ <%= product.price.toFixed(2) %>)" target="_blank" class="btn btn-outline whatsapp-btn">
            <i class="fab fa-whatsapp"></i> Tirar Dúvidas no WhatsApp
          </a>
        </div>
      </div>
    </div>

    <% if (relatedProducts.length > 0) { %>
    <div class="related-products">
      <h2 class="section-title">Produtos Relacionados</h2>
      <div class="products-grid">
        <% relatedProducts.forEach(product => { %>
          <div class="product-card">
            <div class="product-image">
              <img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy" onerror="this.src='/uploads/products/default.svg'">
              <div class="product-overlay">
                <a href="/product/<%= product.id %>" class="btn btn-small btn-primary"><i class="fas fa-eye"></i> Detalhes</a>
                <button class="btn btn-small btn-accent add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                  <i class="fas fa-cart-plus"></i>
                </button>
              </div>
            </div>
            <div class="product-info">
              <span class="product-category"><%= product.category %></span>
              <h3 class="product-name"><%= product.name %></h3>
              <div class="product-footer">
                <span class="product-price">R$ <%= product.price.toFixed(2).replace('.', ',') %></span>
                <button class="btn btn-sm btn-primary add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                  <i class="fas fa-cart-plus"></i>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script>
function changeQty(delta) {
  const input = document.getElementById('productQty');
  let val = parseInt(input.value) || 1;
  val += delta;
  if (val < 1) val = 1;
  if (val > 99) val = 99;
  input.value = val;
}
function addWithQty(btn) {
  const qty = parseInt(document.getElementById('productQty').value) || 1;
  for (let i = 0; i < qty; i++) {
    addToCart(btn.dataset.id, btn.dataset.name, parseFloat(btn.dataset.price), btn.dataset.image);
  }
  updateCartBadge();
  showToast(`${qty}x ${btn.dataset.name} adicionado ao carrinho!`);
}
</script>

<%- include('partials/footer') %>
