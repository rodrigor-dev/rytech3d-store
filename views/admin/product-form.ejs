<%- include('partials/header', { title: product ? 'Editar Produto' : 'Novo Produto' }) %>

<div class="admin-content">
  <h1><%= product ? 'Editar Produto' : 'Novo Produto' %></h1>

  <% if (error) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
  <% } %>

  <div class="admin-card">
    <div class="admin-card-body">
      <form action="/admin/products/save" method="POST" enctype="multipart/form-data" class="admin-form">
        <% if (product && product.id) { %>
          <input type="hidden" name="id" value="<%= product.id %>">
          <input type="hidden" name="current_image" value="<%= product.image_url %>">
        <% } %>

        <div class="form-row">
          <div class="form-group">
            <label for="name">Nome do Produto *</label>
            <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
          </div>
          <div class="form-group">
            <label for="category">Categoria</label>
            <input type="text" id="category" name="category" value="<%= product ? product.category : 'Geral' %>" placeholder="Ex: Canecas, Chaveiros...">
          </div>
        </div>

        <div class="form-group">
          <label for="description">Descrição *</label>
          <textarea id="description" name="description" rows="4" required><%= product ? product.description : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Preço de Venda (R$) *</label>
            <input type="number" id="price" name="price" step="0.01" min="0" value="<%= product ? product.price : '' %>" required>
          </div>
          <div class="form-group">
            <label for="cost_price">Custo (R$)</label>
            <input type="number" id="cost_price" name="cost_price" step="0.01" min="0" value="<%= product ? product.cost_price : '' %>" placeholder="0,00">
            <small class="form-help" id="costPriceHint"><%= product && product.cost_price ? 'Calculado pela calculadora abaixo' : 'Preenchido pela calculadora abaixo' %></small>
          </div>
          <div class="form-group">
            <label for="delivery_time">Prazo de Entrega *</label>
            <input type="text" id="delivery_time" name="delivery_time" value="<%= product ? product.delivery_time : '' %>" placeholder="Ex: 5-7 dias úteis" required>
          </div>
        </div>

        <!-- ══════════════ CALCULADORA DE CUSTO 3D ══════════════ -->
        <div class="cost-calc" id="costCalc">
          <button type="button" class="cost-calc-toggle" id="costCalcToggle" aria-expanded="<%= costData ? 'true' : 'false' %>">
            <span class="cost-calc-toggle-icon"><i class="fas fa-calculator"></i></span>
            <span class="cost-calc-toggle-text">
              <strong>Calculadora de Custo de Produção</strong>
              <small>Descubra o custo real e o lucro de cada peça</small>
            </span>
            <i class="fas fa-chevron-down cost-calc-chevron"></i>
          </button>

          <div class="cost-calc-panel" id="costCalcPanel" <%= costData ? '' : 'hidden' %>>
            <%
              const cc = costData || {};
              const sv = costSettings || {};
              const mach = machine || {};
              const mq = (typeof margin !== 'undefined' && margin != null && margin !== '') ? margin : (Number(sv.default_margin) || 40);
              const isBlank = typeof blank === 'function' ? blank : (v => v === null || v === undefined || String(v).trim() === '');
              const n2 = (v, f) => { if (isBlank(v)) v = (f || 0); const x = Number(v); return (isFinite(x) ? x : (f || 0)).toFixed(2).replace('.', ','); };
              const n3 = (v, f) => { if (isBlank(v)) v = (f || 0); const x = Number(v); return (isFinite(x) ? x : (f || 0)).toFixed(3).replace('.', ','); };
            %>

            <!-- Resumo da máquina -->
            <div class="cost-machine-bar">
              <div class="cost-machine-bar-head">
                <i class="fas fa-print"></i>
                <span>Sua impressora</span>
                <button type="button" class="cost-link-btn" id="costEditSettings">Ajustar valores</button>
              </div>
              <div class="cost-machine-grid">
                <div><b id="mWattage"><%= mach.wattage != null ? mach.wattage : 0 %></b><span>watts</span></div>
                <div><b id="mHourly"><%= n2(mach.hourly) %></b><span>R$/hora</span></div>
                <div><b id="mDep"><%= n2(mach.depreciation) %></b><span>depreciação/h</span></div>
                <div><b id="mEnergy"><%= n2(mach.energy) %></b><span>energia/h</span></div>
              </div>
            </div>

            <!-- Configurações globais (recolhível) -->
            <div class="cost-settings-box" id="costSettingsBox" hidden>
              <h4><i class="fas fa-sliders-h"></i> Valores fixos da produção</h4>
              <p class="cost-hint">Use os valores da sua conta de luz e da sua impressora. Ficam salvos e valem para todos os produtos.</p>
              <div class="cost-settings-grid">
                <label class="cost-field">
                  <span>Tarifa de energia (R$/kWh)</span>
                  <input type="number" step="0.01" min="0" id="s_energy_rate" value="<%= n2(sv.energy_rate, 1.13) %>">
                </label>
                <label class="cost-field">
                  <span>Consumo da impressora (kWh/h)</span>
                  <input type="number" step="0.001" min="0" id="s_printer_power" value="<%= n3(sv.printer_power, 0.10) %>">
                </label>
                <label class="cost-field">
                  <span>Investimento na impressora (R$)</span>
                  <input type="number" step="0.01" min="0" id="s_printer_price" value="<%= n2(sv.printer_price, 5500) %>">
                </label>
                <label class="cost-field">
                  <span>Vida útil (horas)</span>
                  <input type="number" step="1" min="1" id="s_printer_life_hours" value="<%= Number(sv.printer_life_hours) || 15000 %>">
                </label>
                <label class="cost-field">
                  <span>Manutenção por hora (R$)</span>
                  <input type="number" step="0.01" min="0" id="s_maintenance_hourly" value="<%= n2(sv.maintenance_hourly, 0.05) %>">
                </label>
                <label class="cost-field">
                  <span>Preço do filamento (R$/g)</span>
                  <input type="number" step="0.001" min="0" id="s_filament_price" value="<%= n3(sv.filament_price, 0.10) %>">
                </label>
                <label class="cost-field">
                  <span>Embalagem (R$)</span>
                  <input type="number" step="0.01" min="0" id="s_packaging_cost" value="<%= n2(sv.packaging_cost, 3) %>">
                </label>
                <label class="cost-field">
                  <span>Taxa de falha padrão (%)</span>
                  <input type="number" step="0.1" min="0" max="95" id="s_failure_rate" value="<%= Number(sv.failure_rate) || 0 %>">
                </label>
              </div>
              <button type="button" class="btn btn-primary btn-small" id="costSaveSettings">
                <i class="fas fa-save"></i> Salvar valores
              </button>
            </div>

            <!-- Entradas do produto -->
            <h4 class="cost-section-title">Peça</h4>
            <div class="cost-fields-grid">
              <label class="cost-field">
                <span>Filamento usado (g) <i class="fas fa-circle-info cost-tip" title="Peso final da peça. Adicione suporte e purga no campo de desperdício abaixo."></i></span>
                <input type="number" step="0.1" min="0" class="cost-input" id="c_filament_grams" value="<%= cc.filament_grams || '' %>" placeholder="Ex: 85">
              </label>
              <label class="cost-field">
                <span>Horas de impressão <i class="fas fa-circle-info cost-tip" title="Tempo real de impressão do primeiro ao último camada, conforme o fatiador."></i></span>
                <input type="number" step="0.1" min="0" class="cost-input" id="c_print_hours" value="<%= cc.print_hours || '' %>" placeholder="Ex: 3,5">
              </label>
              <label class="cost-field">
                <span>Desperdício / suporte (%)</span>
                <input type="number" step="1" min="0" max="200" class="cost-input" id="c_material_waste_pct" value="<%= cc.material_waste_pct || 0 %>">
              </label>
              <label class="cost-field">
                <span>Taxa de falha (%)</span>
                <input type="number" step="0.1" min="0" max="95" class="cost-input" id="c_failure_rate" value="<%= cc.failure_rate != null ? cc.failure_rate : '' %>" placeholder="<%= sv.failure_rate != null ? sv.failure_rate : 10 %>">
              </label>
            </div>

            <h4 class="cost-section-title">Acabamento <small>opcional</small></h4>
            <div class="cost-fields-grid">
              <label class="cost-field">
                <span>Horas de acabamento</span>
                <input type="number" step="0.1" min="0" class="cost-input" id="c_labor_hours" value="<%= cc.labor_hours || 0 %>">
              </label>
              <label class="cost-field">
                <span>Valor da hora (R$)</span>
                <input type="number" step="0.01" min="0" class="cost-input" id="c_labor_rate" value="<%= cc.labor_rate || 0 %>">
              </label>
            </div>

            <h4 class="cost-section-title">Outros custos <small>opcional</small></h4>
            <p class="cost-hint cost-hint-block">Deixe em branco para usar o valor fixo. Preencha para customizar só neste produto.</p>
            <div class="cost-fields-grid">
              <label class="cost-field">
                <span>Embalagem (R$)</span>
                <input type="number" step="0.01" min="0" class="cost-input" id="c_packaging_cost" value="<%= isBlank(cc.packaging_cost) ? '' : cc.packaging_cost %>" placeholder="fixo: <%= n2(sv.packaging_cost, 3) %>">
              </label>
              <label class="cost-field">
                <span>Outros (R$)</span>
                <input type="number" step="0.01" min="0" class="cost-input" id="c_additional_cost" value="<%= isBlank(cc.additional_cost) ? '' : cc.additional_cost %>" placeholder="fixo: <%= n2(sv.other_costs, 0) %>">
              </label>
            </div>

            <!-- Resultado -->
            <div class="cost-result" id="costResult">
              <div class="cost-result-main">
                <span class="cost-result-label">Custo real por peça</span>
                <strong id="r_total">R$ 0,00</strong>
                <span class="cost-result-note" id="r_profitNote">Informe filograma e horas para calcular</span>
              </div>
              <div class="cost-result-grid">
                <div class="cost-chips">
                  <div class="cost-chip"><span>Material</span><b id="r_material">R$ 0,00</b></div>
                  <div class="cost-chip"><span>Máquina</span><b id="r_machine">R$ 0,00</b></div>
                  <div class="cost-chip"><span>Mão de obra</span><b id="r_labor">R$ 0,00</b></div>
                  <div class="cost-chip"><span>Embalagem + extras</span><b id="r_extras">R$ 0,00</b></div>
                </div>
                <div class="cost-profit">
                  <div class="cost-profit-row">
                    <span>Lucro por peça</span>
                    <b id="r_profit">R$ 0,00</b>
                  </div>
                  <div class="cost-profit-row">
                    <span>Margem</span>
                    <b id="r_margin">0%</b>
                  </div>
                </div>
              </div>
              <p class="cost-hint cost-origin" id="r_origin"></p>
              <div class="cost-suggest">
                <div class="cost-suggest-input">
                  <label class="cost-field cost-suggest-field" for="c_target_margin">
                    <span>Margem de lucro desejada</span>
                    <span class="cost-input-wrap">
                      <input type="number" step="1" min="0" max="95" id="c_target_margin" value="<%= mq %>" inputmode="numeric">
                      <i class="cost-input-suffix">%</i>
                    </span>
                  </label>
                  <div class="cost-margin-presets" id="costMarginPresets">
                    <button type="button" class="cost-preset" data-margin="20">20%</button>
                    <button type="button" class="cost-preset" data-margin="30">30%</button>
                    <button type="button" class="cost-preset" data-margin="40">40%</button>
                    <button type="button" class="cost-preset" data-margin="50">50%</button>
                    <button type="button" class="cost-preset" data-margin="60">60%</button>
                  </div>
                </div>
                <div class="cost-suggest-out">
                  <span>Venda sugerida</span>
                  <strong id="r_suggested">R$ 0,00</strong>
                  <small id="r_suggestedNote">para 40% de lucro</small>
                </div>
              </div>
            </div>

            <div class="cost-actions">
              <button type="button" class="btn btn-primary" id="costApply">
                <i class="fas fa-check"></i> Aplicar custo em "Custo (R$)"
              </button>
              <p class="cost-hint" id="costStatus"></p>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Vídeo do Produto (opcional)</label>
          <div class="video-upload-area" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <label class="btn btn-outline" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px">
              <i class="fas fa-upload"></i> Selecionar Arquivo
              <input type="file" id="videoFile" accept="video/mp4,video/webm,video/ogg,video/quicktime" style="display:none" onchange="handleVideo(this)">
            </label>
            <span style="color:var(--text-muted);font-size:0.85rem">MP4, WebM, OGG, MOV — máx. 100MB</span>
          </div>
          <div id="videoPreview" style="margin-top:8px">
            <% if (product && product.video_url) { %>
              <div class="video-preview-item" style="display:flex;align-items:center;gap:12px;padding:8px 12px;background:var(--bg-secondary);border-radius:var(--radius-sm);border:1px solid var(--border)">
                <i class="fas fa-video" style="font-size:1.2rem;color:var(--accent)"></i>
                <span style="flex:1;font-size:0.85rem;word-break:break-all">
                  <% if (product.video_url.includes('youtube') || product.video_url.includes('youtu.be')) { %>
                    Vídeo do YouTube
                  <% } else { %>
                    <%= product.video_url.split('/').pop() %>
                  <% } %>
                </span>
                <input type="hidden" name="video_url_input" value="<%= product.video_url %>">
                <button type="button" class="btn btn-danger btn-small" onclick="deleteVideo()"><i class="fas fa-trash"></i></button>
              </div>
            <% } %>
          </div>
          <small class="form-help" id="videoHelp">Ou cole uma URL externa (YouTube, Vimeo):</small>
          <input type="text" id="videoUrlInput" name="video_url_fallback" value="<%= product && product.video_url && !product.video_url.startsWith('/uploads/') ? product.video_url : '' %>" placeholder="https://youtube.com/watch?v=..." class="form-control" style="font-family:monospace;margin-top:4px">
        </div>

        <div class="form-group" id="mainMediaGroup" style="<%= product && product.video_url && product.image_url && product.image_url !== '/uploads/products/default.svg' ? '' : 'display:none' %>">
          <label>Mídia Principal na Página do Produto</label>
          <div style="display:flex;gap:16px;margin-top:6px">
            <label class="variation-option <%= !product || product.main_media === 'image' || !product.main_media ? 'selected' : '' %>">
              <input type="radio" name="main_media" value="image" <%= (!product || product.main_media === 'image' || !product.main_media) ? 'checked' : '' %> onchange="toggleMainMedia()">
              <span><i class="fas fa-image"></i> Foto</span>
            </label>
            <label class="variation-option <%= product && product.main_media === 'video' ? 'selected' : '' %>">
              <input type="radio" name="main_media" value="video" <%= product && product.main_media === 'video' ? 'checked' : '' %> onchange="toggleMainMedia()">
              <span><i class="fas fa-video"></i> Vídeo</span>
            </label>
          </div>
          <small class="form-help">Define o que aparece primeiro na página do produto: a foto principal ou o vídeo.</small>
        </div>

        <div class="form-group">
          <label>Imagens do Produto (máx. 6)</label>
          <div class="image-upload-area">
            <label class="btn btn-outline" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px">
              <i class="fas fa-upload"></i> Selecionar Imagens
              <input type="file" id="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="display:none" onchange="handleFiles(this)">
            </label>
            <span id="imageCount" class="form-help" style="margin-left:8px"></span>
            <div id="uploadProgress" style="margin-top:8px;font-size:0.85rem;color:var(--text-muted)"></div>
          </div>
            <small class="form-help">Formatos: JPEG, PNG, GIF, WebP. Clique em uma imagem para defini-la como principal.</small>
          <div id="imagePreviewContainer" class="image-preview-grid">
            <% if (product && product.image_url && product.image_url !== '/uploads/products/default.svg') { %>
              <div class="image-preview-item" data-existing="<%= product.image_url %>" onclick="setMainImage(this,'<%= product.image_url %>')" style="cursor:pointer;border-color:var(--accent);border-width:2px">
                <img src="<%= product.image_url %>" alt="" onerror="this.closest('.image-preview-item').remove()">
                <span class="img-badge">Principal</span>
                <input type="hidden" name="existing_images" value="<%= product.image_url %>">
                <button type="button" class="img-del-btn" onclick="event.stopPropagation();removeExisting(this,'<%= product.image_url %>')"><i class="fas fa-times"></i></button>
              </div>
            <% } %>
            <% if (product && product.extraImages) { product.extraImages.forEach(img => { %>
              <div class="image-preview-item" data-existing="<%= img.image_url %>" onclick="setMainImage(this,'<%= img.image_url %>')" style="cursor:pointer">
                <img src="<%= img.image_url %>" alt="" onerror="this.closest('.image-preview-item').remove()">
                <input type="hidden" name="existing_images" value="<%= img.image_url %>">
                <button type="button" class="img-del-btn" onclick="event.stopPropagation();removeExisting(this,'<%= img.image_url %>')"><i class="fas fa-times"></i></button>
              </div>
            <% }) } %>
          </div>
          <input type="hidden" name="removed_images" id="removedImages" value="">
          <input type="hidden" name="selected_main_image" id="selectedMainImage" value="<%= product && product.image_url ? product.image_url : '' %>">
        </div>

        <div class="form-row">
          <div class="form-group form-check">
            <label class="checkbox-label">
              <input type="checkbox" name="featured" value="1" <%= product && product.featured ? 'checked' : '' %>>
              <span>Produto em Destaque</span>
            </label>
          </div>
          <div class="form-group form-check">
            <label class="checkbox-label">
              <input type="checkbox" name="active" value="1" <%= !product || product.active ? 'checked' : '' %>>
              <span>Produto Ativo no Site</span>
            </label>
          </div>
        </div>

        <div class="admin-card" style="margin-top:24px">
          <div class="admin-card-header">
            <h2>Variações do Produto</h2>
            <small class="form-help">Opcional. Adicione cores, tamanhos ou outras opções</small>
          </div>
          <div class="admin-card-body" id="variations-section">
            <p class="text-muted" id="variations-save-first" style="<%= product ? 'display:none' : '' %>">Salve o produto primeiro para poder adicionar variações.</p>
            <div id="variations-container" style="<%= product ? '' : 'display:none' %>">
              <% if (typeof variations !== 'undefined' && variations && variations.length > 0) { %>
                <% variations.forEach((v, idx) => { %>
                  <div class="variation-row">
                    <select class="form-control variation-group" style="width:auto;min-width:120px">
                      <option value="Cor" <%= v.group_name === 'Cor' ? 'selected' : '' %>>Cor</option>
                      <option value="Tamanho" <%= v.group_name === 'Tamanho' ? 'selected' : '' %>>Tamanho</option>
                      <option value="Material" <%= v.group_name === 'Material' ? 'selected' : '' %>>Material</option>
                      <option value="Outro" <%= !['Cor','Tamanho','Material'].includes(v.group_name) ? 'selected' : '' %>>Outro</option>
                    </select>
                    <input type="text" class="form-control variation-name" value="<%= v.variation_name %>" placeholder="Ex: Vermelho" style="width:auto;min-width:140px">
                    <input type="number" class="form-control variation-price" value="<%= v.price_modifier || 0 %>" step="0.10" placeholder="+R$" style="width:80px">
                    <button type="button" class="btn btn-danger btn-small" onclick="this.closest('.variation-row').remove()">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                <% }) %>
              <% } %>
            </div>
            <button type="button" class="btn btn-outline btn-small" onclick="addVariation()" style="margin-top:8px; <%= product ? '' : 'display:none' %>" id="variations-add-btn">
              <i class="fas fa-plus"></i> Adicionar Variação
            </button>
            <button type="button" class="btn btn-primary btn-small" onclick="saveVariations()" style="margin-top:8px; <%= product ? '' : 'display:none' %>" id="variations-save-btn">
              <i class="fas fa-save"></i> Salvar Variações
            </button>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar</button>
          <a href="/admin/products" class="btn btn-outline">Cancelar</a>
          <% if (product && product.id) { %>
            <button type="button" class="btn btn-danger" style="margin-left:auto" onclick="deleteProduct()">
              <i class="fas fa-trash"></i> Excluir Produto
            </button>
          <% } %>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
.image-preview-grid { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
.image-preview-item { position: relative; width: 120px; height: 120px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
.image-preview-item img { width: 100%; height: 100%; object-fit: cover; }
.img-del-btn { position: absolute; top: 2px; right: 2px; width: 22px; height: 22px; border-radius: 50%; border: none; background: rgba(239,68,68,0.9); color: #fff; font-size: 0.65rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; z-index:2; }
.img-del-btn:hover { background: var(--red); transform: scale(1.1); }
</style>

<style>
.variation-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
.variation-row .form-control { padding: 6px 10px; font-size: 0.85rem; }
</style>
<script>
function addVariation() {
  const container = document.getElementById('variations-container');
  const row = document.createElement('div');
  row.className = 'variation-row';
  row.innerHTML = `
    <select class="form-control variation-group" style="width:auto;min-width:120px">
      <option value="Cor">Cor</option>
      <option value="Tamanho">Tamanho</option>
      <option value="Material">Material</option>
      <option value="Outro">Outro</option>
    </select>
    <input type="text" class="form-control variation-name" placeholder="Ex: Vermelho" style="width:auto;min-width:140px">
    <input type="number" class="form-control variation-price" value="0" step="0.10" placeholder="+R$" style="width:80px">
    <button type="button" class="btn btn-danger btn-small" onclick="this.closest('.variation-row').remove()">
      <i class="fas fa-times"></i>
    </button>
  `;
  container.appendChild(row);
}
function saveVariations() {
  const productId = <%= product ? product.id : 'null' %>;
  if (!productId) return alert('Salve o produto primeiro.');
  const rows = document.querySelectorAll('#variations-container .variation-row');
  const variations = [];
  rows.forEach(row => {
    const group = row.querySelector('.variation-group').value;
    const name = row.querySelector('.variation-name').value.trim();
    const price = row.querySelector('.variation-price').value;
    if (name) variations.push({ group_name: group, variation_name: name, price_modifier: price });
  });
  fetch('/admin/products/variations/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId, variations })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) alert('Variações salvas com sucesso!');
    else alert(data.error || 'Erro ao salvar.');
  })
  .catch(() => alert('Erro ao salvar variações.'));
}
function handleFiles(input) {
  const files = Array.from(input.files);
  const container = document.getElementById('imagePreviewContainer');
  const existing = container.querySelectorAll('.image-preview-item').length;
  const maxTotal = 6;
  const maxNew = maxTotal - existing;
  const toAdd = files.slice(0, maxNew);
  const progress = document.getElementById('uploadProgress');
  let uploaded = 0;

  toAdd.forEach((file, idx) => {
    const formData = new FormData();
    formData.append('file', file);

    // Show preview immediately using FileReader
    const reader = new FileReader();
    reader.onload = function(e) {
      const div = document.createElement('div');
      div.className = 'image-preview-item';
      div.innerHTML = '<div class="img-loader"><i class="fas fa-spinner fa-spin"></i></div>';
      div.innerHTML += '<img src="'+e.target.result+'" alt="">';
      container.appendChild(div);

      // Upload file via AJAX
      fetch('/admin/upload-image', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
          if (data.url) {
            var url = data.url;
            div.innerHTML = '';
            div.style.cursor = 'pointer';
            div.onclick = function() { setMainImage(div, url); };
            if (existing === 0 && idx === 0) {
              div.style.borderColor = 'var(--accent)';
              div.style.borderWidth = '2px';
              div.innerHTML += '<span class="img-badge">Principal</span>';
              document.getElementById('selectedMainImage').value = url;
            }
            div.innerHTML += '<img src="'+e.target.result+'" alt="">';
            div.innerHTML += '<input type="hidden" name="uploaded_images" value="'+url+'">';
            div.innerHTML += '<button type="button" class="img-del-btn" onclick="event.stopPropagation();this.closest(\'.image-preview-item\').remove()"><i class="fas fa-times"></i></button>';
            div.dataset.uploaded = '1';
            uploaded++;
            progress.textContent = uploaded + '/' + toAdd.length + ' enviadas';
            showMainMediaGroup();
          } else {
            div.remove();
            alert('Erro ao enviar ' + file.name + ': ' + (data.error || 'Erro desconhecido'));
          }
          updateImageCount();
        })
        .catch(function() {
          div.remove();
          alert('Erro de conexão ao enviar ' + file.name);
          updateImageCount();
        });
    };
    reader.readAsDataURL(file);
  });
  if (files.length > maxNew) {
    alert('Máximo de ' + maxTotal + ' imagens no total. ' + files.length + ' selecionadas, mas só cabem ' + maxNew + ' novas.');
  }
  if (toAdd.length > 0) progress.textContent = 'Enviando 0/' + toAdd.length + '...';
}
function setMainImage(el, url) {
  document.querySelectorAll('#imagePreviewContainer .image-preview-item').forEach(function(item) {
    item.style.borderColor = '';
    item.style.borderWidth = '';
    var badge = item.querySelector('.img-badge');
    if (badge) badge.remove();
  });
  el.style.borderColor = 'var(--accent)';
  el.style.borderWidth = '2px';
  var span = document.createElement('span');
  span.className = 'img-badge';
  span.textContent = 'Principal';
  el.appendChild(span);
  document.getElementById('selectedMainImage').value = url;
}

function removeExisting(btn, url) {
  if (!confirm('Remover esta imagem?')) return;
  const removed = document.getElementById('removedImages');
  const existing = removed.value ? removed.value.split(',') : [];
  existing.push(url);
  removed.value = existing.join(',');
  var item = btn.closest('.image-preview-item');
  var selectedInput = document.getElementById('selectedMainImage');
  if (selectedInput.value === url) {
    selectedInput.value = '';
    var remaining = document.querySelector('#imagePreviewContainer .image-preview-item:not([style*="display"])');
    if (remaining) {
      var firstUrl = remaining.querySelector('input[name="existing_images"], input[name="uploaded_images"]');
      if (firstUrl) setMainImage(remaining, firstUrl.value);
    }
  }
  item.remove();
  updateImageCount();
  showMainMediaGroup();
}
function updateImageCount() {
  const count = document.querySelectorAll('#imagePreviewContainer .image-preview-item').length;
  document.getElementById('imageCount').textContent = count + '/6 imagens';
}
function handleVideo(input) {
  const file = input.files[0];
  if (!file) return;
  const formData = new FormData();
  formData.append('file', file);
  const preview = document.getElementById('videoPreview');
  const help = document.getElementById('videoHelp');
  preview.innerHTML = '<div style="padding:12px;color:var(--text-muted)"><i class="fas fa-spinner fa-spin"></i> Enviando vídeo...</div>';
  fetch('/admin/upload-video', { method: 'POST', body: formData })
    .then(r => r.json())
    .then(data => {
      if (data.url) {
        preview.innerHTML = '<div class="video-preview-item" style="display:flex;align-items:center;gap:12px;padding:8px 12px;background:var(--bg-secondary);border-radius:var(--radius-sm);border:1px solid var(--border)">'
          + '<i class="fas fa-video" style="font-size:1.2rem;color:var(--accent)"></i>'
          + '<span style="flex:1;font-size:0.85rem;word-break:break-all">' + file.name + '</span>'
          + '<input type="hidden" name="uploaded_video" value="' + data.url + '">'
          + '<button type="button" class="btn btn-danger btn-small" onclick="deleteVideo()"><i class="fas fa-trash"></i></button>'
          + '</div>';
        document.getElementById('videoUrlInput').value = '';
        help.textContent = 'Vídeo enviado! Você pode substituir por uma URL externa abaixo:';
        showMainMediaGroup();
      } else {
        preview.innerHTML = '';
        alert('Erro ao enviar vídeo: ' + (data.error || 'Erro desconhecido'));
      }
    })
    .catch(function() {
      preview.innerHTML = '';
      alert('Erro de conexão ao enviar vídeo.');
    });
}

function showMainMediaGroup() {
  const group = document.getElementById('mainMediaGroup');
  const hasImage = document.querySelector('#imagePreviewContainer .image-preview-item[data-existing], input[name="uploaded_images"]');
  const hasVideo = document.querySelector('#videoPreview input[name="uploaded_video"]') || document.querySelector('#videoPreview input[name="video_url_input"]');
  if (hasImage && hasVideo) {
    group.style.display = '';
  } else {
    group.style.display = 'none';
  }
}

function toggleMainMedia() {
  document.querySelectorAll('#mainMediaGroup .variation-option').forEach(function(el) {
    el.classList.toggle('selected', el.querySelector('input').checked);
  });
}

function deleteVideo() {
  if (!confirm('Remover este vídeo?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  const preview = document.getElementById('videoPreview');
  const hasUploaded = preview.querySelector('input[name="uploaded_video"]');
  if (hasUploaded || !productId) {
    preview.innerHTML = '';
    document.getElementById('videoUrlInput').value = '';
    document.getElementById('videoHelp').textContent = 'Ou cole uma URL externa (YouTube, Vimeo):';
    showMainMediaGroup();
    return;
  }
  fetch('/admin/products/delete-video', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert(data.error || 'Erro ao remover vídeo');
  })
  .catch(() => alert('Erro ao remover vídeo.'));
}
function deleteProduct() {
  if (!confirm('Tem certeza que deseja EXCLUIR este produto permanentemente?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  fetch('/admin/products/delete/' + productId, { method: 'POST' })
  .then(r => {
    if (r.redirected) window.location = r.url;
    else window.location = '/admin/products';
  })
  .catch(() => alert('Erro ao excluir produto.'));
}
document.addEventListener('DOMContentLoaded', function() {
  updateImageCount();
  var mainImg = document.querySelector('#imagePreviewContainer .img-badge');
  if (mainImg) {
    var parent = mainImg.closest('.image-preview-item');
    if (parent) {
      var url = parent.querySelector('input[name="existing_images"]') || parent.querySelector('input[name="uploaded_images"]');
      if (url) document.getElementById('selectedMainImage').value = url.value;
    }
  }
});

// ══════════════ CALCULADORA DE CUSTO 3D ══════════════
(function() {
  var PRODUCT_ID = <%= product && product.id ? product.id : 'null' %>;

  var $ = function(id) { return document.getElementById(id); };
  var fmtBRL = function(n) {
    var v = Number(n) || 0;
    return 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var num = function(v) {
    if (typeof v === 'number') return isFinite(v) ? v : 0;
    if (!v) return 0;
    var s = String(v).trim().replace(/[R$\s%]/g, '');
    if (!s) return 0;
    if (s.indexOf(',') !== -1 && s.indexOf('.') !== -1) s = s.replace(/\./g, '').replace(',', '.');
    else if (s.indexOf(',') !== -1) s = s.replace(',', '.');
    var n = parseFloat(s);
    return isFinite(n) ? n : 0;
  };

  var toggle = $('costCalcToggle');
  var panel = $('costCalcPanel');
  if (!toggle || !panel) return;

  toggle.addEventListener('click', function() {
    var isOpen = !panel.hasAttribute('hidden');
    if (isOpen) { panel.setAttribute('hidden', ''); toggle.setAttribute('aria-expanded', 'false'); }
    else { panel.removeAttribute('hidden'); toggle.setAttribute('aria-expanded', 'true'); recalc(); }
  });

  // --- Coleta de dados ---
  // Campos em branco são enviados como '' para que o servidor use o valor fixo.
  function collect() {
    return {
      filament_grams: num($('c_filament_grams').value),
      print_hours: num($('c_print_hours').value),
      material_waste_pct: num($('c_material_waste_pct').value),
      failure_rate: num($('c_failure_rate').value),
      labor_hours: num($('c_labor_hours').value),
      labor_rate: num($('c_labor_rate').value),
      packaging_cost: $('c_packaging_cost').value.trim(),
      additional_cost: $('c_additional_cost').value.trim(),
      target_margin: num($('c_target_margin').value),
      sale_price: num($('price').value)
    };
  }

  var lastTotal = 0;

  // --- Renderização ---
  function render(d) {
    lastTotal = d.total_cost;
    var b = d.breakdown;
    $('r_total').textContent = fmtBRL(d.total_cost);
    $('r_material').textContent = fmtBRL(b.material);
    $('r_machine').textContent = fmtBRL(b.machine);
    $('r_labor').textContent = fmtBRL(b.labor);
    $('r_extras').textContent = fmtBRL(b.packaging + b.additional);
    $('r_suggested').textContent = fmtBRL(d.suggested_price);
    $('r_suggestedNote').textContent = 'para ' + d.target_margin + '% de lucro';

    var sale = num($('price').value);
    var profit = sale - d.total_cost;
    $('r_profit').textContent = fmtBRL(profit);
    $('r_profit').className = profit > 0 ? 'is-positive' : (profit < 0 ? 'is-negative' : '');

    var m = d.current_margin;
    $('r_margin').textContent = m.toFixed(1).replace('.', ',') + '%';
    $('r_margin').className = m >= 30 ? 'is-good' : (m > 0 ? 'is-ok' : 'is-negative');

    if (d.filament_grams > 0 || d.print_hours > 0) {
      $('r_profitNote').textContent = b.failureWaste > 0
        ? 'Inclui ' + d.failure_rate + '% de falha e ' + b.failureWaste.toFixed(2).replace('.', ',') + ' de retrabalho'
        : 'Material + máquina + acabamento';
    } else {
      $('r_profitNote').textContent = 'Informe filamento e horas para calcular';
    }

    if (d.machine) {
      $('mHourly').textContent = d.machine.hourly.toFixed(2).replace('.', ',');
      $('mDep').textContent = d.machine.depreciation.toFixed(2).replace('.', ',');
      $('mEnergy').textContent = d.machine.energy.toFixed(2).replace('.', ',');
      $('mWattage').textContent = d.machine.wattage;
    }

    // Informa a origem dos custos fixos: padrão da loja ou customizado nesta peça
    var orig = [];
    if (b.packagingCustom) orig.push('embalagem customizada');
    if (b.additionalCustom) orig.push('extras customizados');
    $('r_origin').textContent = orig.length
      ? 'Usando ' + orig.join(' e ') + ' nesta peça.'
      : 'Embalagem e extras usando os valores fixos da loja.';
  }

  function setStatus(txt, kind) {
    var el = $('costStatus');
    el.textContent = txt;
    el.className = 'cost-hint' + (kind ? ' is-' + kind : '');
  }

  var timer = null;
  function recalc() {
    if (panel.hasAttribute('hidden')) return;
    clearTimeout(timer);
    timer = setTimeout(function() {
      fetch('/admin/api/products/cost-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(collect())
      })
      .then(function(r) {
        if (r.status === 401) throw new Error('Sua sessão expirou. Recarregue a página.');
        if (!r.ok) throw new Error('Não foi possível calcular agora.');
        return r.json();
      })
      .then(function(d) {
        if (!d || d.error) throw new Error((d && d.error) || 'Erro no cálculo.');
        render(d);
        setStatus('', null);
      })
      .catch(function(err) { setStatus(err.message || 'Erro de conexão.', 'error'); });
    }, 180);
  }

  // --- Atalhos de margem ---
  var presets = $('costMarginPresets');
  if (presets) {
    presets.addEventListener('click', function(e) {
      var btn = e.target.closest('.cost-preset');
      if (!btn) return;
      $('c_target_margin').value = btn.getAttribute('data-margin');
      recalc();
    });
  }

  // --- Eventos dos campos ---
  document.querySelectorAll('.cost-input, #c_target_margin, #price').forEach(function(el) {
    el.addEventListener('input', recalc);
    el.addEventListener('change', recalc);
  });

  // --- Configurações globais ---
  var settingsBox = $('costSettingsBox');
  $('costEditSettings').addEventListener('click', function() {
    settingsBox.hasAttribute('hidden') ? settingsBox.removeAttribute('hidden') : settingsBox.setAttribute('hidden', '');
  });

  $('costSaveSettings').addEventListener('click', function() {
    var btn = this;
    var body = {
      energy_rate: $('s_energy_rate').value,
      printer_power: $('s_printer_power').value,
      printer_price: $('s_printer_price').value,
      printer_life_hours: $('s_printer_life_hours').value,
      maintenance_hourly: $('s_maintenance_hourly').value,
      packaging_cost: $('s_packaging_cost').value,
      filament_price: $('s_filament_price').value,
      failure_rate: $('s_failure_rate').value
    };
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
    fetch('/admin/cost-settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(body)
    })
    .then(function(r) {
      if (r.status === 401) throw new Error('Sua sessão expirou. Recarregue a página.');
      return r.json();
    })
    .then(function(d) {
      if (d.success) {
        setStatus('Valores salvos. Eles valem para todos os produtos.', 'ok');
        recalc();
        setTimeout(function() { settingsBox.setAttribute('hidden', ''); }, 900);
      } else {
        setStatus(d.error || 'Erro ao salvar.', 'error');
      }
    })
    .catch(function(err) { setStatus(err.message || 'Erro de conexão.', 'error'); })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-save"></i> Salvar valores';
    });
  });

  // --- Aplicar custo no campo principal ---
  $('costApply').addEventListener('click', function() {
    var g = num($('c_filament_grams').value);
    var h = num($('c_print_hours').value);
    if (g <= 0 && h <= 0) {
      setStatus('Informe o filamento (g) e as horas de impressão primeiro.', 'error');
      return;
    }
    $('cost_price').value = lastTotal.toFixed(2);
    $('costPriceHint').textContent = 'Calculado automaticamente — ' + fmtBRL(lastTotal);
    setStatus('Custo aplicado. Não esqueça de salvar o produto.', 'ok');
    $('cost_price').dispatchEvent(new Event('input', { bubbles: true }));
  });

  if (!panel.hasAttribute('hidden')) recalc();
})();
</script>

