<%- include('partials/header', { title: product ? 'Editar Produto' : 'Novo Produto' }) %>

<div class="admin-content">
  <h1><%= product ? 'Editar Produto' : 'Novo Produto' %></h1>

  <% if (error) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
  <% } %>

  <div class="admin-card">
    <div class="admin-card-body">
      <form action="/admin/products/save" method="POST" enctype="multipart/form-data" class="admin-form">
        <% if (product && product.id) { %>
          <input type="hidden" name="id" value="<%= product.id %>">
          <input type="hidden" name="current_image" value="<%= product.image_url %>">
        <% } %>

        <div class="form-row">
          <div class="form-group">
            <label for="name">Nome do Produto *</label>
            <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
          </div>
          <div class="form-group">
            <label for="category">Categoria</label>
            <input type="text" id="category" name="category" value="<%= product ? product.category : 'Geral' %>" placeholder="Ex: Canecas, Chaveiros...">
          </div>
        </div>

        <div class="form-group">
          <label for="description">Descrição *</label>
          <textarea id="description" name="description" rows="4" required><%= product ? product.description : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Preço (R$) *</label>
            <input type="number" id="price" name="price" step="0.01" min="0" value="<%= product ? product.price : '' %>" required>
          </div>
          <div class="form-group">
            <label for="delivery_time">Prazo de Entrega *</label>
            <input type="text" id="delivery_time" name="delivery_time" value="<%= product ? product.delivery_time : '' %>" placeholder="Ex: 5-7 dias úteis" required>
          </div>
        </div>

        <div class="form-group">
          <label for="video_url_input">URL do Vídeo (opcional)</label>
          <input type="text" id="video_url_input" name="video_url_input" value="<%= product && product.video_url ? product.video_url : '' %>" placeholder="https://youtube.com/watch?v=... ou URL direto do vídeo" class="form-control" style="font-family:monospace">
          <small class="form-help">YouTube, Vimeo, ou link direto de vídeo hospedado externamente</small>
          <% if (product && product.video_url) { %>
            <div style="margin-top:8px">
              <button type="button" class="btn btn-danger btn-small" onclick="deleteVideo()"><i class="fas fa-trash"></i> Remover Vídeo</button>
            </div>
          <% } %>
        </div>

        <div class="form-group">
          <label>Imagem Principal</label>
          <div class="image-upload-row">
            <div class="image-file-option">
              <label class="btn btn-outline btn-small" style="cursor:pointer">
                <i class="fas fa-upload"></i> Upload do Computador
                <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none" onchange="document.getElementById('imageFileName').textContent = this.files[0]?.name || 'Nenhum'">
              </label>
              <span id="imageFileName" class="form-help" style="margin-left:8px">Nenhum arquivo</span>
            </div>
            <small class="form-help" style="display:block;margin-top:4px">Formatos: JPEG, PNG, GIF, WebP</small>
          </div>
          <div class="image-url-option" style="margin-top:8px">
            <label for="image_url_input">Ou cole uma URL externa</label>
            <input type="text" id="image_url_input" name="image_url_input" value="<%= product && product.image_url && (product.image_url.startsWith('http') || product.image_url === '/uploads/products/default.svg') ? product.image_url : '' %>" placeholder="https://i.ibb.co/xxxxx/imagem.jpg (link direto, com i.ibb.co)" class="form-control" style="font-family:monospace;margin-top:4px">
            <small class="form-help">Use ImgBB, Cloudinary, etc. URL <strong>começa com https://i.ibb.co/</strong> (não esquece o "i.")</small>
          </div>
        </div>

        <div class="form-group">
          <label>Imagens Extras</label>
          <div id="extraImagesContainer">
            <% if (product && product.extraImages) { product.extraImages.forEach((img, idx) => { %>
              <div class="extra-image-row" style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
                <input type="text" name="extra_images" value="<%= img.image_url %>" placeholder="https://i.ibb.co/xxxxx/imagem.jpg" class="form-control" style="font-family:monospace">
                <button type="button" class="btn btn-danger btn-small" onclick="this.closest('.extra-image-row').remove()"><i class="fas fa-times"></i></button>
              </div>
            <% }) } %>
          </div>
          <button type="button" class="btn btn-outline btn-small" onclick="addExtraImage()" style="margin-top:6px">
            <i class="fas fa-plus"></i> Adicionar Imagem Extra
          </button>
        </div>

        <% if (product && product.image_url && product.image_url !== '/uploads/products/default.svg') { %>
          <div class="current-images">
            <p>Imagens atuais no servidor:</p>
            <div class="image-preview-grid">
              <div class="image-preview-item">
                <img src="<%= product.image_url %>" alt="<%= product.name %>" onerror="this.style.display='none'">
                <span class="main-badge">Principal</span>
                <button type="button" class="img-del-btn" onclick="deleteMainImage()" title="Remover imagem principal"><i class="fas fa-times"></i></button>
              </div>
              <% if (product.extraImages) { product.extraImages.forEach(img => { %>
                <div class="image-preview-item">
                  <img src="<%= img.image_url %>" alt="Extra" onerror="this.style.display='none'">
                  <button type="button" class="img-del-btn" onclick="deleteImage('<%= img.image_url %>')" title="Remover"><i class="fas fa-times"></i></button>
                </div>
              <% }) } %>
            </div>
          </div>
        <% } %>

        <div class="form-row">
          <div class="form-group form-check">
            <label class="checkbox-label">
              <input type="checkbox" name="featured" value="1" <%= product && product.featured ? 'checked' : '' %>>
              <span>Produto em Destaque</span>
            </label>
          </div>
          <div class="form-group form-check">
            <label class="checkbox-label">
              <input type="checkbox" name="active" value="1" <%= !product || product.active ? 'checked' : '' %>>
              <span>Produto Ativo no Site</span>
            </label>
          </div>
        </div>

        <div class="admin-card" style="margin-top:24px">
          <div class="admin-card-header">
            <h2>Variações do Produto</h2>
            <small class="form-help">Opcional. Adicione cores, tamanhos ou outras opções</small>
          </div>
          <div class="admin-card-body" id="variations-section">
            <p class="text-muted" id="variations-save-first" style="<%= product ? 'display:none' : '' %>">Salve o produto primeiro para poder adicionar variações.</p>
            <div id="variations-container" style="<%= product ? '' : 'display:none' %>">
              <% if (typeof variations !== 'undefined' && variations && variations.length > 0) { %>
                <% variations.forEach((v, idx) => { %>
                  <div class="variation-row">
                    <select class="form-control variation-group" style="width:auto;min-width:120px">
                      <option value="Cor" <%= v.group_name === 'Cor' ? 'selected' : '' %>>Cor</option>
                      <option value="Tamanho" <%= v.group_name === 'Tamanho' ? 'selected' : '' %>>Tamanho</option>
                      <option value="Material" <%= v.group_name === 'Material' ? 'selected' : '' %>>Material</option>
                      <option value="Outro" <%= !['Cor','Tamanho','Material'].includes(v.group_name) ? 'selected' : '' %>>Outro</option>
                    </select>
                    <input type="text" class="form-control variation-name" value="<%= v.variation_name %>" placeholder="Ex: Vermelho" style="width:auto;min-width:140px">
                    <input type="number" class="form-control variation-price" value="<%= v.price_modifier || 0 %>" step="0.10" placeholder="+R$" style="width:80px">
                    <button type="button" class="btn btn-danger btn-small" onclick="this.closest('.variation-row').remove()">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                <% }) %>
              <% } %>
            </div>
            <button type="button" class="btn btn-outline btn-small" onclick="addVariation()" style="margin-top:8px; <%= product ? '' : 'display:none' %>" id="variations-add-btn">
              <i class="fas fa-plus"></i> Adicionar Variação
            </button>
            <button type="button" class="btn btn-primary btn-small" onclick="saveVariations()" style="margin-top:8px; <%= product ? '' : 'display:none' %>" id="variations-save-btn">
              <i class="fas fa-save"></i> Salvar Variações
            </button>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar</button>
          <a href="/admin/products" class="btn btn-outline">Cancelar</a>
          <% if (product && product.id) { %>
            <button type="button" class="btn btn-danger" style="margin-left:auto" onclick="deleteProduct()">
              <i class="fas fa-trash"></i> Excluir Produto
            </button>
          <% } %>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
.image-preview-grid { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
.image-preview-item { position: relative; width: 120px; height: 120px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
.image-preview-item img { width: 100%; height: 100%; object-fit: cover; }
.main-badge { position: absolute; bottom: 0; left: 0; right: 0; background: var(--accent); color: #000; font-size: 0.7rem; text-align: center; padding: 2px; font-weight: 600; }
.img-del-btn { position: absolute; top: 2px; right: 2px; width: 22px; height: 22px; border-radius: 50%; border: none; background: rgba(239,68,68,0.9); color: #fff; font-size: 0.65rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; z-index:2; }
.img-del-btn:hover { background: var(--red); transform: scale(1.1); }
</style>

<style>
.variation-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
.variation-row .form-control { padding: 6px 10px; font-size: 0.85rem; }
</style>
<script>
function addVariation() {
  const container = document.getElementById('variations-container');
  const row = document.createElement('div');
  row.className = 'variation-row';
  row.innerHTML = `
    <select class="form-control variation-group" style="width:auto;min-width:120px">
      <option value="Cor">Cor</option>
      <option value="Tamanho">Tamanho</option>
      <option value="Material">Material</option>
      <option value="Outro">Outro</option>
    </select>
    <input type="text" class="form-control variation-name" placeholder="Ex: Vermelho" style="width:auto;min-width:140px">
    <input type="number" class="form-control variation-price" value="0" step="0.10" placeholder="+R$" style="width:80px">
    <button type="button" class="btn btn-danger btn-small" onclick="this.closest('.variation-row').remove()">
      <i class="fas fa-times"></i>
    </button>
  `;
  container.appendChild(row);
}
function saveVariations() {
  const productId = <%= product ? product.id : 'null' %>;
  if (!productId) return alert('Salve o produto primeiro.');
  const rows = document.querySelectorAll('#variations-container .variation-row');
  const variations = [];
  rows.forEach(row => {
    const group = row.querySelector('.variation-group').value;
    const name = row.querySelector('.variation-name').value.trim();
    const price = row.querySelector('.variation-price').value;
    if (name) variations.push({ group_name: group, variation_name: name, price_modifier: price });
  });
  fetch('/admin/products/variations/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId, variations })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) alert('Variações salvas com sucesso!');
    else alert(data.error || 'Erro ao salvar.');
  })
  .catch(() => alert('Erro ao salvar variações.'));
}
function addExtraImage() {
  const container = document.getElementById('extraImagesContainer');
  const row = document.createElement('div');
  row.className = 'extra-image-row';
  row.style.cssText = 'display:flex;align-items:center;gap:6px;margin-bottom:6px';
  row.innerHTML = '<input type="text" name="extra_images" placeholder="https://i.ibb.co/xxxxx/imagem.jpg" class="form-control" style="font-family:monospace"> <button type="button" class="btn btn-danger btn-small" onclick="this.closest(\'.extra-image-row\').remove()"><i class="fas fa-times"></i></button>';
  container.appendChild(row);
}
function deleteImage(url) {
  if (!confirm('Remover esta imagem extra?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  fetch('/admin/products/delete-extra-image', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId, image_url: url })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert(data.error || 'Erro ao remover imagem');
  })
  .catch(() => alert('Erro ao remover imagem.'));
}
function deleteMainImage() {
  if (!confirm('Remover a imagem principal?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  fetch('/admin/products/delete-main-image', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert(data.error || 'Erro ao remover imagem principal');
  })
  .catch(() => alert('Erro ao remover imagem principal.'));
}
function deleteVideo() {
  if (!confirm('Remover este vídeo?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  fetch('/admin/products/delete-video', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ product_id: productId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert(data.error || 'Erro ao remover vídeo');
  })
  .catch(() => alert('Erro ao remover vídeo.'));
}
function deleteProduct() {
  if (!confirm('Tem certeza que deseja EXCLUIR este produto permanentemente?')) return;
  const productId = <%= product ? product.id : 'null' %>;
  fetch('/admin/products/delete/' + productId, { method: 'POST' })
  .then(r => {
    if (r.redirected) window.location = r.url;
    else window.location = '/admin/products';
  })
  .catch(() => alert('Erro ao excluir produto.'));
}
</script>

<%- include('partials/footer') %>
