<%- include('partials/header', { title: 'Pedido #' + order.id }) %>

<div class="admin-content">
  <div class="admin-header">
    <h1>Pedido #<%= order.id %></h1>
    <div style="display:flex;gap:8px">
      <a href="/admin/orders/<%= order.id %>/edit" class="btn btn-outline"><i class="fas fa-edit"></i> Editar Pedido</a>
      <a href="/admin/orders" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Voltar</a>
    </div>
  </div>

<% 
  const orderCost = items.reduce((sum, item) => sum + (parseFloat(item.cost_price || 0) * item.quantity), 0);
  const orderProfit = order.total - orderCost;
  const orderMargin = order.total > 0 ? (orderProfit / order.total * 100) : 0;
  const profitClass = orderProfit > 0 ? 'profit-positive' : (orderProfit < 0 ? 'profit-negative' : '');
  const isManual = order.notes && order.notes.startsWith('__MANUAL__|');
  const parts = isManual ? order.notes.split('|') : [];
  const manualName = isManual && parts.length > 1 ? parts[1] : null;
  const manualCompany = isManual && parts.length > 2 ? parts[2] : '';
  const manualPhone = isManual && parts.length > 3 ? parts[3] : '';
  const manualEmail = isManual && parts.length > 4 ? parts[4] : '';
  const manualNotes = isManual && parts.length > 5 ? parts.slice(5).join('|') : '';
%>
  <div class="order-detail-grid">
    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Informações do Pedido</h2>
      </div>
      <div class="admin-card-body">
        <div class="detail-row">
          <span class="detail-label">Status</span>
          <span class="badge badge-<%= order.status %> badge-lg"><%= order.status === 'pending' ? 'Pendente' : order.status === 'confirmed' ? 'Confirmado' : order.status === 'printing' ? 'Imprimindo' : order.status === 'shipped' ? 'Enviado' : order.status === 'delivered' ? 'Entregue' : 'Cancelado' %></span>
        </div>
        <div class="detail-row"><span class="detail-label">Data</span><span><%= new Date(order.created_at).toLocaleString('pt-BR') %></span></div>
        <div class="detail-row">
          <span class="detail-label">Origem</span>
          <span><span class="badge badge-<%= isManual ? 'manual' : 'site' %>"><%= isManual ? 'Manual' : 'Site' %></span></span>
        </div>
        <div class="detail-row"><span class="detail-label">Total</span><span class="detail-value">R$ <%= order.total.toFixed(2).replace('.', ',') %></span></div>
        <% if (!isManual && order.notes) { %><div class="detail-row"><span class="detail-label">Observações</span><span><%= order.notes %></span></div><% } %>
        <% if (isManual && manualNotes) { %><div class="detail-row"><span class="detail-label">Observações</span><span><%= manualNotes %></span></div><% } %>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Resumo Financeiro</h2>
      </div>
      <div class="admin-card-body">
        <div class="detail-row"><span class="detail-label">Custo Total</span><span>R$ <%= orderCost.toFixed(2).replace('.', ',') %></span></div>
        <div class="detail-row"><span class="detail-label">Lucro</span><span class="<%= profitClass %> detail-value">R$ <%= orderProfit.toFixed(2).replace('.', ',') %></span></div>
        <div class="detail-row"><span class="detail-label">Margem</span><span class="<%= profitClass %>"><%= orderMargin.toFixed(2).replace('.', ',') %>%</span></div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <h2><%= isManual ? 'Dados do Cliente (Pedido Manual)' : 'Dados do Cliente' %></h2>
      </div>
      <div class="admin-card-body">
        <% if (isManual) { %>
          <div class="detail-row"><span class="detail-label">Nome</span><span><%= manualName || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Empresa</span><span><%= manualCompany || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Telefone</span><span><%= manualPhone || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Email</span><span><%= manualEmail || '—' %></span></div>
          <div class="detail-row"><span class="detail-label">Endereço</span><span>Pedido manual — sem endereço cadastrado</span></div>
        <% } else { %>
          <div class="detail-row"><span class="detail-label">Nome</span><span><%= order.full_name %></span></div>
          <div class="detail-row"><span class="detail-label">CPF</span><span><%= String(order.cpf).replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4') %></span></div>
          <div class="detail-row"><span class="detail-label">Email</span><span><%= order.email %></span></div>
          <div class="detail-row"><span class="detail-label">Telefone</span><span><%= String(order.phone).replace(/(\d{2})(\d{4,5})(\d{4})/, '($1) $2-$3') %></span></div>
          <div class="detail-row"><span class="detail-label">Endereço</span><span><%= order.street %>, <%= order.number %><%= order.complement ? ' - ' + order.complement : '' %></span></div>
          <div class="detail-row"><span class="detail-label">Bairro</span><span><%= order.neighborhood %></span></div>
          <div class="detail-row"><span class="detail-label">Cidade/UF</span><span><%= order.city %>/<%= order.state %></span></div>
          <div class="detail-row"><span class="detail-label">CEP</span><span><%= String(order.zip_code).replace(/(\d{5})(\d{3})/, '$1-$2') %></span></div>
        <% } %>
        <% if (!isManual) { %>
        <div class="detail-actions">
          <a href="https://wa.me/55<%= String(order.phone).replace(/\D/g, '') %>" target="_blank" class="btn btn-small btn-outline"><i class="fab fa-whatsapp"></i> Falar com Cliente</a>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Itens do Pedido</h2>
    </div>
    <div class="admin-card-body">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Quantidade</th>
              <th>Preço Unit.</th>
              <th>Desconto</th>
              <th>Custo Unit.</th>
              <th>Lucro</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => {
              const itemCost = parseFloat(item.cost_price || 0) * item.quantity;
              const itemSub = item.quantity * item.price;
              let itemDiscount = 0;
              let discStr = '—';
              if (item.variations) {
                try {
                  const vars = typeof item.variations === 'string' ? JSON.parse(item.variations) : item.variations;
                  if (vars.__discount__) {
                    itemDiscount = vars.__discount__.total || 0;
                    if (vars.__discount__.type === 'fixed') discStr = 'R$ ' + vars.__discount__.value.toFixed(2).replace('.', ',');
                    else if (vars.__discount__.type === 'percent') discStr = vars.__discount__.value + '%';
                  }
                } catch {}
              }
              const itemFinal = itemSub - itemDiscount;
              const itemProfit = itemFinal - itemCost;
              const ipClass = itemProfit > 0 ? 'profit-positive' : (itemProfit < 0 ? 'profit-negative' : '');
            %>
              <tr>
                <td>
                <%= item.product_name %>
                <% if (item.variations) { 
                  let vars;
                  try { vars = typeof item.variations === 'string' ? JSON.parse(item.variations) : item.variations; } catch { vars = {}; }
                  const varEntries = Object.entries(vars).filter(([k]) => k !== '__discount__');
                  const varStr = varEntries.map(([k,v]) => k + ': ' + (v.name || v)).join(', ');
                  if (varStr) { %><br><small style="color:var(--text-muted)"><%= varStr %></small><% } %>
                <% } %>
              </td>
                <td><%= item.quantity %></td>
                <td>R$ <%= item.price.toFixed(2).replace('.', ',') %></td>
                <td style="color:#ff9f1c"><%= discStr %></td>
                <td>R$ <%= (parseFloat(item.cost_price || 0)).toFixed(2).replace('.', ',') %></td>
                <td class="<%= ipClass %>">R$ <%= itemProfit.toFixed(2).replace('.', ',') %></td>
                <td>R$ <%= itemFinal.toFixed(2).replace('.', ',') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Atualizar Status</h2>
    </div>
    <div class="admin-card-body">
      <form action="/admin/orders/status/<%= order.id %>" method="POST" class="status-form">
        <div class="form-row">
          <div class="form-group">
            <select name="status" class="form-control">
              <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pendente</option>
              <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmado</option>
              <option value="printing" <%= order.status === 'printing' ? 'selected' : '' %>>Imprimindo</option>
              <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Enviado</option>
              <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Entregue</option>
              <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelado</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Atualizar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>WhatsApp</h2>
    </div>
    <div class="admin-card-body">
      <p class="text-muted" style="margin-bottom:12px">Compartilhe os detalhes do pedido via WhatsApp:</p>
      <% if (isManual) { %>
        <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=<%= encodeURIComponent('🛒 *PEDIDO MANUAL #' + order.id + '*\n\n👤 Cliente: ' + (manualName || '—') + '\n📦 Total: R$ ' + order.total.toFixed(2) + '\n📱 Telefone: ' + (manualPhone || '—') + '\n\n✅ Status: ' + order.status) %>" target="_blank" class="btn btn-outline">
          <i class="fab fa-whatsapp"></i> Enviar Detalhes para WhatsApp
        </a>
      <% } else { %>
        <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=<%= encodeURIComponent('🛒 *NOVO PEDIDO #' + order.id + '*\n\n👤 Cliente: ' + order.full_name + '\n📦 Total: R$ ' + order.total.toFixed(2) + '\n📱 Telefone: ' + order.phone + '\n\n📍 Endereço: ' + order.street + ', ' + order.number + ' - ' + order.neighborhood + ', ' + order.city + '/' + order.state + '\n\n✅ Status: ' + order.status) %>" target="_blank" class="btn btn-outline">
          <i class="fab fa-whatsapp"></i> Enviar Detalhes para WhatsApp
        </a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
