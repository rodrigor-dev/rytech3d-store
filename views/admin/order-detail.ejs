<%- include('admin/partials/header', { title: 'Pedido #' + order.id }) %>

<div class="admin-content">
  <div class="admin-header">
    <h1>Pedido #<%= order.id %></h1>
    <a href="/admin/orders" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Voltar</a>
  </div>

  <div class="order-detail-grid">
    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Informações do Pedido</h2>
      </div>
      <div class="admin-card-body">
        <div class="detail-row">
          <span class="detail-label">Status</span>
          <span class="badge badge-<%= order.status %> badge-lg"><%= order.status === 'pending' ? 'Pendente' : order.status === 'confirmed' ? 'Confirmado' : order.status === 'printing' ? 'Imprimindo' : order.status === 'shipped' ? 'Enviado' : order.status === 'delivered' ? 'Entregue' : 'Cancelado' %></span>
        </div>
        <div class="detail-row"><span class="detail-label">Data</span><span><%= new Date(order.created_at).toLocaleString('pt-BR') %></span></div>
        <div class="detail-row"><span class="detail-label">Total</span><span class="detail-value">R$ <%= order.total.toFixed(2).replace('.', ',') %></span></div>
        <% if (order.notes) { %><div class="detail-row"><span class="detail-label">Observações</span><span><%= order.notes %></span></div><% } %>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Dados do Cliente</h2>
      </div>
      <div class="admin-card-body">
        <div class="detail-row"><span class="detail-label">Nome</span><span><%= order.full_name %></span></div>
        <div class="detail-row"><span class="detail-label">CPF</span><span><%= String(order.cpf).replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4') %></span></div>
        <div class="detail-row"><span class="detail-label">Email</span><span><%= order.email %></span></div>
        <div class="detail-row"><span class="detail-label">Telefone</span><span><%= String(order.phone).replace(/(\d{2})(\d{4,5})(\d{4})/, '($1) $2-$3') %></span></div>
        <div class="detail-row"><span class="detail-label">Endereço</span><span><%= order.street %>, <%= order.number %><%= order.complement ? ' - ' + order.complement : '' %></span></div>
        <div class="detail-row"><span class="detail-label">Bairro</span><span><%= order.neighborhood %></span></div>
        <div class="detail-row"><span class="detail-label">Cidade/UF</span><span><%= order.city %>/<%= order.state %></span></div>
        <div class="detail-row"><span class="detail-label">CEP</span><span><%= String(order.zip_code).replace(/(\d{5})(\d{3})/, '$1-$2') %></span></div>
        <div class="detail-actions">
          <a href="https://wa.me/55<%= String(order.phone).replace(/\D/g, '') %>" target="_blank" class="btn btn-small btn-outline"><i class="fab fa-whatsapp"></i> Falar com Cliente</a>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Itens do Pedido</h2>
    </div>
    <div class="admin-card-body">
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Quantidade</th>
              <th>Preço Unit.</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td><%= item.product_name %></td>
                <td><%= item.quantity %></td>
                <td>R$ <%= item.price.toFixed(2).replace('.', ',') %></td>
                <td>R$ <%= (item.quantity * item.price).toFixed(2).replace('.', ',') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Atualizar Status</h2>
    </div>
    <div class="admin-card-body">
      <form action="/admin/orders/status/<%= order.id %>" method="POST" class="status-form">
        <div class="form-row">
          <div class="form-group">
            <select name="status" class="form-control">
              <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pendente</option>
              <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmado</option>
              <option value="printing" <%= order.status === 'printing' ? 'selected' : '' %>>Imprimindo</option>
              <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Enviado</option>
              <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Entregue</option>
              <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelado</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Atualizar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>WhatsApp</h2>
    </div>
    <div class="admin-card-body">
      <p class="text-muted" style="margin-bottom:12px">Compartilhe os detalhes do pedido via WhatsApp:</p>
      <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=<%= encodeURIComponent('🛒 *NOVO PEDIDO #' + order.id + '*\n\n👤 Cliente: ' + order.full_name + '\n📦 Total: R$ ' + order.total.toFixed(2) + '\n📱 Telefone: ' + order.phone + '\n\n📍 Endereço: ' + order.street + ', ' + order.number + ' - ' + order.neighborhood + ', ' + order.city + '/' + order.state + '\n\n✅ Status: ' + order.status) %>" target="_blank" class="btn btn-outline">
        <i class="fab fa-whatsapp"></i> Enviar Detalhes para WhatsApp
      </a>
    </div>
  </div>
</div>

<%- include('admin/partials/footer') %>
