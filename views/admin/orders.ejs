<%- include('partials/header', { title: 'Pedidos' }) %>

<div class="admin-content">
  <div class="admin-header">
    <h1>Pedidos</h1>
    <a href="/admin/orders/manual/new" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Pedido Manual</a>
  </div>

  <div class="admin-filters">
    <a href="/admin/orders" class="filter-btn <%= !currentStatus && !currentSource ? 'active' : '' %>">Todos</a>
    <a href="/admin/orders?status=pending" class="filter-btn <%= currentStatus === 'pending' ? 'active' : '' %>">Pendentes</a>
    <a href="/admin/orders?status=confirmed" class="filter-btn <%= currentStatus === 'confirmed' ? 'active' : '' %>">Confirmados</a>
    <a href="/admin/orders?status=printing" class="filter-btn <%= currentStatus === 'printing' ? 'active' : '' %>">Imprimindo</a>
    <a href="/admin/orders?status=shipped" class="filter-btn <%= currentStatus === 'shipped' ? 'active' : '' %>">Enviados</a>
    <a href="/admin/orders?status=delivered" class="filter-btn <%= currentStatus === 'delivered' ? 'active' : '' %>">Entregues</a>
  </div>

  <div class="admin-filters" style="margin-top:4px">
    <span style="font-size:0.8rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-right:4px">Origem:</span>
    <a href="/admin/orders<%= currentStatus ? '?status=' + currentStatus : '' %>" class="filter-btn <%= !currentSource ? 'active' : '' %>">Todas</a>
    <a href="/admin/orders?source=site<%= currentStatus ? '&status=' + currentStatus : '' %>" class="filter-btn <%= currentSource === 'site' ? 'active' : '' %>">Site</a>
    <a href="/admin/orders?source=manual<%= currentStatus ? '&status=' + currentStatus : '' %>" class="filter-btn <%= currentSource === 'manual' ? 'active' : '' %>">Manual</a>
  </div>

  <div class="admin-card">
    <div class="admin-card-body">
      <% if (orders.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-shopping-cart"></i>
          <h3>Nenhum pedido encontrado</h3>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="admin-table table-cards">
            <thead>
              <tr>
                <th>#</th>
                <th>Origem</th>
                <th>Cliente</th>
                <th>Itens</th>
                <th>Total</th>
                <th>Custo</th>
                <th>Lucro</th>
                <th>Margem</th>
                <th>Status</th>
                <th>Data</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => {
                const isManual = order.notes && order.notes.startsWith('__MANUAL__|');
                const parts = isManual ? order.notes.split('|') : [];
                const realName = isManual && parts.length > 1 ? parts[1] : null;
                const displayName = realName || order.customer_name || '—';
                const cost = parseFloat(order.total_cost || 0);
                const profit = order.total - cost;
                const margin = order.total > 0 ? (profit / order.total * 100) : 0;
                const profitClass = profit > 0 ? 'profit-positive' : (profit < 0 ? 'profit-negative' : '');
              %>
                <tr>
                  <td data-label="#">#<%= order.id %></td>
                  <td data-label="Origem"><span class="badge badge-<%= isManual ? 'manual' : 'site' %>" style="font-size:0.75rem"><%= isManual ? 'Manual' : 'Site' %></span></td>
                  <td data-label="Cliente"><%= displayName %></td>
                  <td data-label="Itens"><%= order.total_items || '—' %></td>
                  <td data-label="Total">R$ <%= order.total.toFixed(2).replace('.', ',') %></td>
                  <td data-label="Custo" class="<%= profitClass %>">R$ <%= cost.toFixed(2).replace('.', ',') %></td>
                  <td data-label="Lucro" class="<%= profitClass %>">R$ <%= profit.toFixed(2).replace('.', ',') %></td>
                  <td data-label="Margem" class="<%= profitClass %>"><%= margin.toFixed(2).replace('.', ',') %>%</td>
                  <td data-label="Status"><span class="badge badge-<%= order.status %>"><%= order.status === 'pending' ? 'Pendente' : order.status === 'confirmed' ? 'Confirmado' : order.status === 'printing' ? 'Imprimindo' : order.status === 'shipped' ? 'Enviado' : order.status === 'delivered' ? 'Entregue' : 'Cancelado' %></span></td>
                  <td data-label="Data"><%= new Date(order.created_at).toLocaleDateString('pt-BR') %></td>
                  <td data-label="Ações"><a href="/admin/orders/<%= order.id %>" class="btn btn-small"><i class="fas fa-eye"></i></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
