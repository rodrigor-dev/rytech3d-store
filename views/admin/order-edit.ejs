<%- include('partials/header', { title: 'Editar Pedido #' + order.id }) %>

<div class="admin-content">
  <div class="admin-header">
    <h1>Editar Pedido #<%= order.id %></h1>
    <a href="/admin/orders/<%= order.id %>" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Voltar</a>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
  <% } %>

  <form id="editOrderForm" action="/admin/orders/<%= order.id %>/edit" method="POST">
    <input type="hidden" name="financial_unlock" id="financialUnlockInput" value="0">

    <% if (!isManual) { %>
      <input type="hidden" name="customer_cpf" value="<%= order.cpf %>">
      <input type="hidden" name="customer_cep" value="<%= order.zip_code %>">
      <input type="hidden" name="customer_street" value="<%= order.street %>">
      <input type="hidden" name="customer_number" value="<%= order.number %>">
      <input type="hidden" name="customer_complement" value="<%= order.complement %>">
      <input type="hidden" name="customer_neighborhood" value="<%= order.neighborhood %>">
      <input type="hidden" name="customer_city" value="<%= order.city %>">
      <input type="hidden" name="customer_state" value="<%= order.state %>">
    <% } %>

    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Dados do Cliente</h2>
        <span class="badge badge-<%= isManual ? 'manual' : 'site' %>"><%= isManual ? 'Manual' : 'Site' %></span>
      </div>
      <div class="admin-card-body">
        <div class="form-row">
          <div class="form-group">
            <label for="customer_name">Nome do Cliente *</label>
            <input type="text" id="customer_name" name="customer_name" class="form-control" required value="<%= customerName %>">
          </div>
          <div class="form-group">
            <label for="customer_company">Empresa</label>
            <input type="text" id="customer_company" name="customer_company" class="form-control" value="<%= customerCompany %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="customer_phone">Telefone</label>
            <input type="text" id="customer_phone" name="customer_phone" class="form-control" value="<%= customerPhone %>">
          </div>
          <div class="form-group">
            <label for="customer_email">E-mail</label>
            <input type="email" id="customer_email" name="customer_email" class="form-control" value="<%= customerEmail %>">
          </div>
        </div>
        <div class="form-group">
          <label for="admin_notes">Observações Internas</label>
          <textarea id="admin_notes" name="admin_notes" class="form-control" rows="2"><%= adminNotes %></textarea>
        </div>
      </div>
    </div>

    <div class="admin-card" style="margin-top:16px">
      <div class="admin-card-header">
        <h2>Itens do Pedido</h2>
        <div style="display:flex;gap:8px">
          <button type="button" class="btn btn-outline btn-small" onclick="addRow()"><i class="fas fa-plus"></i> Adicionar Item</button>
        </div>
      </div>
      <div class="admin-card-body" style="overflow-x:auto">
        <table class="admin-table" id="itemsTable">
          <thead>
            <tr>
              <th style="min-width:200px">Produto</th>
              <th style="min-width:60px">Qtd.</th>
              <th style="min-width:100px">Preço Unit.</th>
              <th style="min-width:80px">Custo Unit.</th>
              <th style="min-width:100px">Desconto</th>
              <th style="min-width:60px">Valor Desc.</th>
              <th style="min-width:100px">Valor Final</th>
              <th style="min-width:100px">Lucro</th>
              <th style="width:40px"></th>
            </tr>
          </thead>
          <tbody id="itemsBody">
          </tbody>
        </table>
        <p id="noItemsMsg" class="text-muted" style="text-align:center;padding:24px">Nenhum item neste pedido.</p>
      </div>
    </div>

    <div class="admin-card" style="margin-top:16px">
      <div class="admin-card-header">
        <h2>Edição Financeira</h2>
        <div>
          <button type="button" id="unlockBtn" class="btn btn-accent btn-small" onclick="toggleUnlock()">
            <i class="fas fa-lock"></i> <span id="unlockText">Desbloquear Edição Financeira</span>
          </button>
        </div>
      </div>
      <div class="admin-card-body">
        <div id="finWarning" class="alert alert-error" style="display:none;margin-bottom:16px">
          <i class="fas fa-exclamation-triangle"></i> Cuidado! Alterações financeiras afetam lucros, custos e relatórios.
        </div>
        <div class="finance-summary" style="margin-bottom:0">
          <div class="finance-card">
            <div class="label">Subtotal</div>
            <div class="value" id="summarySubtotal">R$ 0,00</div>
          </div>
          <div class="finance-card">
            <div class="label">Descontos</div>
            <div class="value" style="color:#ff9f1c" id="summaryDiscount">R$ 0,00</div>
          </div>
          <div class="finance-card">
            <div class="label">Valor Final</div>
            <div class="value" id="summaryFinal">R$ 0,00</div>
          </div>
          <div class="finance-card">
            <div class="label">Custo Total</div>
            <div class="value negative" id="summaryCost">R$ 0,00</div>
          </div>
          <div class="finance-card">
            <div class="label">Lucro</div>
            <div class="value" id="summaryProfit">R$ 0,00</div>
          </div>
          <div class="finance-card">
            <div class="label">Margem</div>
            <div class="value" id="summaryMargin">0,00%</div>
          </div>
        </div>

        <div id="reasonGroup" style="display:none;margin-top:16px">
          <div class="form-group">
            <label for="edit_reason">Motivo da Alteração Financeira *</label>
            <select id="edit_reason" name="edit_reason" class="form-control">
              <option value="">Selecione um motivo...</option>
              <option value="Correção de cadastro">Correção de cadastro</option>
              <option value="Desconto concedido posteriormente">Desconto concedido posteriormente</option>
              <option value="Ajuste solicitado pelo cliente">Ajuste solicitado pelo cliente</option>
              <option value="Erro operacional">Erro operacional</option>
              <option value="Reajuste de preço">Reajuste de preço</option>
              <option value="Troca de produto">Troca de produto</option>
              <option value="Outro">Outro</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="form-actions" style="margin-top:16px">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar Alterações</button>
      <a href="/admin/orders/<%= order.id %>" class="btn btn-outline">Cancelar</a>
    </div>
  </form>

  <% if (history && history.length > 0) { %>
  <div class="admin-card" style="margin-top:16px">
    <div class="admin-card-header">
      <h2>Histórico de Alterações</h2>
    </div>
    <div class="admin-card-body">
      <div class="history-list">
        <% history.forEach(function(h) { %>
          <div class="history-item">
            <div class="history-date"><%= new Date(h.created_at).toLocaleString('pt-BR') %></div>
            <div class="history-field"><strong><%= h.field_name %></strong></div>
            <% if (h.reason) { %><div class="history-reason">Motivo: <%= h.reason %></div><% } %>
            <div class="history-values">
              <span class="history-old"><%= h.old_value %></span>
              <span class="history-arrow">↓</span>
              <span class="history-new"><%= h.new_value %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>
</div>

<script>
var products = <%- JSON.stringify(products) %>;
var existingItems = <%- JSON.stringify(items) %>;
var rowCount = 0;
var financialUnlocked = <%= financialUnlocked ? 'true' : 'false' %>;

function esc(v) { return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function fmt(n) {
  if (isNaN(n)) return 'R$ 0,00';
  return 'R$ ' + n.toFixed(2).replace('.', ',');
}

function addRow(data) {
  data = data || {};
  var tbody = document.getElementById('itemsBody');
  var idx = rowCount++;
  var row = document.createElement('tr');
  row.id = 'row-' + idx;
  var productOpts = '<option value="">Selecione um produto</option>';
  for (var pi = 0; pi < products.length; pi++) {
    var p = products[pi];
    productOpts += '<option value="' + p.id + '" ' + (data.product_id == p.id ? 'selected' : '') + '>' + esc(p.name) + '</option>';
  }
  row.innerHTML =
    '<td>' +
      '<select name="items[' + idx + '][product_id]" class="form-control product-select" data-idx="' + idx + '" style="width:100%" onchange="onProductChange(' + idx + ')">' +
        productOpts +
      '</select>' +
      '<input type="hidden" name="items[' + idx + '][product_name]" id="pname-' + idx + '" value="' + esc(data.product_name || '') + '">' +
    '</td>' +
    '<td><input type="number" name="items[' + idx + '][quantity]" class="form-control" style="width:60px" value="' + (data.quantity || 1) + '" min="1" onchange="recalc()" oninput="recalc()"></td>' +
    '<td><input type="number" name="items[' + idx + '][price]" id="pprice-' + idx + '" class="form-control fin-field" style="width:100px" step="0.01" min="0" value="' + (data.price || '') + '" onchange="recalc()" oninput="recalc()" ' + (financialUnlocked ? '' : 'readonly') + '></td>' +
    '<td><input type="number" name="items[' + idx + '][cost_price]" id="pcost-' + idx + '" class="form-control fin-field" style="width:80px" step="0.01" min="0" value="' + (data.cost_price || '') + '" ' + (financialUnlocked ? '' : 'readonly') + '></td>' +
    '<td>' +
      '<select name="items[' + idx + '][discount_type]" class="form-control fin-field" style="width:100px" onchange="onDiscountChange(' + idx + ')" ' + (financialUnlocked ? '' : 'disabled') + '>' +
        '<option value="none"' + ((data.discount_type === 'none' || !data.discount_type) ? ' selected' : '') + '>Sem desc.</option>' +
        '<option value="fixed"' + (data.discount_type === 'fixed' ? ' selected' : '') + '>R$ fixo</option>' +
        '<option value="percent"' + (data.discount_type === 'percent' ? ' selected' : '') + '>%</option>' +
      '</select>' +
    '</td>' +
    '<td><input type="number" name="items[' + idx + '][discount_value]" class="form-control fin-field" style="width:60px" step="0.01" min="0" value="' + (data.discount_value || '') + '" onchange="recalc()" oninput="recalc()" id="dval-' + idx + '" ' + (financialUnlocked ? '' : 'readonly') + '></td>' +
    '<td id="tfinal-' + idx + '" style="font-weight:600">' + (data.price ? fmt(parseFloat(data.price) * (data.quantity || 1)) : '—') + '</td>' +
    '<td id="tprofit-' + idx + '" style="font-weight:600">—</td>' +
    '<td><button type="button" class="btn btn-danger btn-small" onclick="removeRow(' + idx + ')"><i class="fas fa-times"></i></button></td>';
  tbody.appendChild(row);
  document.getElementById('noItemsMsg').style.display = 'none';
  recalc();
}

function removeRow(idx) {
  var row = document.getElementById('row-' + idx);
  if (row) { row.remove(); recalc(); }
  var tbody = document.getElementById('itemsBody');
  if (tbody.children.length === 0) {
    document.getElementById('noItemsMsg').style.display = '';
  }
}

function onProductChange(idx) {
  var sel = document.querySelector('select[data-idx="' + idx + '"]');
  var pid = parseInt(sel.value);
  var prod = null;
  for (var pi = 0; pi < products.length; pi++) {
    if (products[pi].id === pid) { prod = products[pi]; break; }
  }
  if (prod) {
    document.getElementById('pname-' + idx).value = prod.name;
    if (!financialUnlocked) {
      document.getElementById('pprice-' + idx).value = prod.price;
    }
    document.getElementById('pcost-' + idx).value = prod.cost_price || 0;
  } else {
    document.getElementById('pname-' + idx).value = '';
    if (!financialUnlocked) {
      document.getElementById('pprice-' + idx).value = '';
    }
    document.getElementById('pcost-' + idx).value = '';
  }
  recalc();
}

function onDiscountChange(idx) {
  var sel = document.querySelector('#row-' + idx + ' select[name*="discount_type"]');
  if (sel.value === 'none') {
    document.getElementById('dval-' + idx).value = '';
  }
  recalc();
}

function recalc() {
  var tbody = document.getElementById('itemsBody');
  var rows = tbody.querySelectorAll('tr');
  var subtotal = 0, totalDiscount = 0, totalCost = 0;

  rows.forEach(function(row) {
    var idx = row.id.replace('row-', '');
    var qty = parseFloat(row.querySelector('input[name*="quantity"]').value) || 0;
    var price = parseFloat(row.querySelector('input[name*="price"]').value) || 0;
    var cost = parseFloat(row.querySelector('input[name*="cost_price"]').value) || 0;
    var discType = row.querySelector('select[name*="discount_type"]').value;
    var discVal = parseFloat(row.querySelector('input[name*="discount_value"]').value) || 0;

    var itemSub = price * qty;
    var itemDiscount = 0;
    if (discType === 'fixed') {
      itemDiscount = Math.min(discVal, price) * qty;
    } else if (discType === 'percent') {
      itemDiscount = price * (Math.min(discVal, 100) / 100) * qty;
    }
    var itemFinal = itemSub - itemDiscount;
    var itemCost = cost * qty;
    var itemProfit = itemFinal - itemCost;

    subtotal += itemSub;
    totalDiscount += itemDiscount;
    totalCost += itemCost;

    document.getElementById('tfinal-' + idx).textContent = itemFinal > 0 ? fmt(itemFinal) : '—';
    document.getElementById('tprofit-' + idx).textContent = fmt(itemProfit);
    document.getElementById('tprofit-' + idx).className = itemProfit > 0 ? 'profit-positive' : (itemProfit < 0 ? 'profit-negative' : '');
  });

  var finalVal = subtotal - totalDiscount;
  var profit = finalVal - totalCost;
  var margin = finalVal > 0 ? (profit / finalVal) * 100 : 0;

  document.getElementById('summarySubtotal').textContent = fmt(subtotal);
  document.getElementById('summaryDiscount').textContent = fmt(totalDiscount);
  document.getElementById('summaryFinal').textContent = fmt(finalVal);
  document.getElementById('summaryFinal').style.color = finalVal > 0 ? '' : 'var(--red)';
  document.getElementById('summaryCost').textContent = fmt(totalCost);
  document.getElementById('summaryProfit').textContent = fmt(profit);
  document.getElementById('summaryProfit').className = profit > 0 ? 'profit-positive' : (profit < 0 ? 'profit-negative' : '');
  document.getElementById('summaryProfit').style.fontSize = '1.8rem';
  document.getElementById('summaryProfit').style.fontWeight = '700';
  document.getElementById('summaryProfit').style.marginTop = '4px';
  document.getElementById('summaryMargin').textContent = margin.toFixed(2).replace('.', ',') + '%';
  document.getElementById('summaryMargin').className = margin > 0 ? 'profit-positive' : (margin < 0 ? 'profit-negative' : '');
  document.getElementById('summaryMargin').style.fontSize = '1.8rem';
  document.getElementById('summaryMargin').style.fontWeight = '700';
  document.getElementById('summaryMargin').style.marginTop = '4px';
}

function toggleUnlock() {
  financialUnlocked = !financialUnlocked;
  document.getElementById('financialUnlockInput').value = financialUnlocked ? '1' : '0';
  var btn = document.getElementById('unlockBtn');
  var warning = document.getElementById('finWarning');
  var reason = document.getElementById('reasonGroup');
  btn.className = financialUnlocked ? 'btn btn-small btn-danger' : 'btn btn-accent btn-small';
  btn.innerHTML = financialUnlocked
    ? '<i class="fas fa-unlock"></i> <span id="unlockText">Bloquear Edição Financeira</span>'
    : '<i class="fas fa-lock"></i> <span id="unlockText">Desbloquear Edição Financeira</span>';
  warning.style.display = financialUnlocked ? '' : 'none';
  reason.style.display = financialUnlocked ? '' : 'none';

  document.querySelectorAll('.fin-field').forEach(function(el) {
    if (el.tagName === 'SELECT') {
      el.disabled = !financialUnlocked;
    } else {
      if (financialUnlocked) {
        el.removeAttribute('readonly');
      } else {
        el.setAttribute('readonly', '');
      }
    }
  });
}

// Load existing items
for (var ei = 0; ei < existingItems.length; ei++) {
  addRow(existingItems[ei]);
}

// Handle form submission: re-index items and validate
document.getElementById('editOrderForm').addEventListener('submit', function(e) {
  var tbody = document.getElementById('itemsBody');
  var rows = tbody.querySelectorAll('tr');
  if (rows.length === 0) {
    e.preventDefault();
    alert('Adicione pelo menos um item ao pedido.');
    return;
  }

  if (financialUnlocked) {
    var reason = document.getElementById('edit_reason').value;
    if (!reason) {
      e.preventDefault();
      alert('Informe o motivo da alteração financeira.');
      return;
    }
  }

  rows.forEach(function(row, i) {
    row.querySelectorAll('input, select').forEach(function(el) {
      var name = el.getAttribute('name');
      if (name) {
        var newName = name.replace(/\[\d+\]/, '[' + i + ']');
        el.setAttribute('name', newName);
      }
    });
  });
});
</script>

<style>
.profit-positive { color: var(--accent); font-weight: 700; }
.profit-negative { color: var(--red); font-weight: 700; }
#itemsTable input[readonly] { background: var(--bg-secondary); cursor: not-allowed; }
#itemsTable select:disabled { background: var(--bg-secondary); cursor: not-allowed; opacity: 0.7; }
.history-list { display: flex; flex-direction: column; gap: 16px; }
.history-item { padding: 12px; background: var(--bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--border); }
.history-date { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px; }
.history-field { font-size: 0.9rem; margin-bottom: 4px; }
.history-reason { font-size: 0.8rem; color: var(--orange); margin-bottom: 4px; }
.history-values { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; }
.history-old { color: var(--red); text-decoration: line-through; }
.history-arrow { color: var(--text-muted); font-weight: 700; }
.history-new { color: var(--accent); font-weight: 600; }
</style>

<%- include('partials/footer') %>