<%
  /* Partial da calculadora de custo 3D.
     Locais aceitos:
       costSettings  – valores fixos da loja
       machine       – resumo do custo/hora
       costData      – ficha salva do produto (opcional)
       isStandalone  – true na aba /admin/calculator
       blank         – helper isBlank do cost-calculator */
  const cc = costData || {};
  const sv = costSettings || {};
  const mach = machine || {};
  const standalone = (typeof isStandalone !== 'undefined' && isStandalone) ? true : false;
  const n2 = (v, f) => { if (v === null || v === undefined || v === '') v = (f || 0); const x = Number(v); return (isFinite(x) ? x : (f || 0)).toFixed(2).replace('.', ','); };
  const nInt = (v, f) => { if (v === null || v === undefined || v === '') v = (f || 0); const x = Number(v); return String(Math.round(isFinite(x) ? x : (f || 0))); };
  const mq = (typeof margin !== 'undefined' && margin !== null && margin !== '') ? margin : (Number(sv.default_margin) || 40);
  const perGram = Number(sv.filament_price) > 0 ? (Number(sv.filament_price) / 1000) : 0;
%>
<% if (standalone) { %>
  <!-- Page header -->
  <div class="calc-hero">
    <div class="calc-hero-text">
      <span class="calc-hero-badge"><i class="fas fa-calculator"></i> Custo real de produção</span>
      <h1>Calculadora de Custo 3D</h1>
      <p>Descubra quanto custa produzir cada peça e por quanto vender com lucro.</p>
    </div>
    <button type="button" class="btn btn-outline calc-hero-edit" id="costEditSettings">
      <i class="fas fa-sliders-h"></i> Editar padrões
    </button>
  </div>
<% } else { %>
  <div class="cost-calc" id="costCalc">
    <button type="button" class="cost-calc-toggle" id="costCalcToggle" aria-expanded="<%= cc && Object.keys(cc).length ? 'true' : 'false' %>">
      <span class="cost-calc-toggle-icon"><i class="fas fa-calculator"></i></span>
      <span class="cost-calc-toggle-text">
        <strong>Calculadora de Custo de Produção</strong>
        <small>Descubra o custo real e o lucro de cada peça</small>
      </span>
      <i class="fas fa-chevron-down cost-calc-chevron"></i>
    </button>
<% } %>

<div class="cost-calc-panel" id="costCalcPanel" <%= (!standalone && !(cc && Object.keys(cc).length)) ? 'hidden' : '' %>>
  <% if (standalone) { %>
    <div class="calc-panel-head">
      <h2><i class="fas fa-sliders-h"></i> Valores fixos da produção</h2>
      <button type="button" class="btn btn-outline btn-small" id="costEditSettingsMobile">
        <i class="fas fa-pen"></i> Editar
      </button>
    </div>
  <% } %>

  <!-- Resumo da máquina -->
  <div class="cost-machine-bar">
    <div class="cost-machine-bar-head">
      <i class="fas fa-print"></i>
      <span>Sua impressora</span>
      <% if (!standalone) { %>
        <button type="button" class="cost-link-btn" id="costEditSettings">Ajustar valores</button>
      <% } %>
    </div>
    <div class="cost-machine-grid">
      <div><b id="mWattage"><%= nInt(mach.wattage, 0) %></b><span>watts</span></div>
      <div><b id="mHourly"><%= n2(mach.hourly) %></b><span>R$/hora</span></div>
      <div><b id="mDep"><%= n2(mach.depreciation) %></b><span>depreciação/h</span></div>
      <div><b id="mEnergy"><%= n2(mach.energy) %></b><span>energia/h</span></div>
    </div>
  </div>

  <!-- Configurações globais (recolhível) -->
  <div class="cost-settings-box" id="costSettingsBox" hidden>
    <h4><i class="fas fa-sliders-h"></i> Valores fixos da produção</h4>
    <p class="cost-hint">Use os valores da sua conta de luz e da sua impressora. Ficam salvos e valem para todos os produtos.</p>
    <div class="cost-settings-grid">
      <label class="cost-field">
        <span>Tarifa de energia (R$/kWh)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_energy_rate" value="<%= n2(sv.energy_rate, 1.13) %>">
          <i class="cost-input-suffix">R$/kWh</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Consumo da impressora (W)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_printer_watts" value="<%= nInt(sv.printer_watts, 180) %>">
          <i class="cost-input-suffix">watts</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Investimento na impressora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_printer_price" value="<%= n2(sv.printer_price, 5500) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Vida útil da impressora</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_printer_life_hours" value="<%= nInt(sv.printer_life_hours, 15000) %>">
          <i class="cost-input-suffix">horas</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Manutenção por hora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_maintenance_hourly" value="<%= n2(sv.maintenance_hourly, 0.05) %>">
          <i class="cost-input-suffix">R$/h</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Preço do filamento (carretel 1kg)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_filament_price" value="<%= n2(sv.filament_price, 130) %>">
          <i class="cost-input-suffix">R$/kg</i>
        </span>
        <small class="cost-unit-hint">equivale a <b id="s_filament_pergram">R$ <%= n2(perGram) %></b> por grama</small>
      </label>
      <label class="cost-field">
        <span>Embalagem (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_packaging_cost" value="<%= n2(sv.packaging_cost, 3) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Taxa de falha padrão (%)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_failure_rate" value="<%= n2(sv.failure_rate, 10) %>">
          <i class="cost-input-suffix">%</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Valor da minha hora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_labor_rate" value="<%= n2(sv.labor_rate, 0) %>">
          <i class="cost-input-suffix">R$/h</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Outros custos fixos (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_other_costs" value="<%= n2(sv.other_costs, 0) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Margem de lucro padrão (%)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_default_margin" value="<%= nInt(sv.default_margin, 40) %>">
          <i class="cost-input-suffix">%</i>
        </span>
      </label>
    </div>
    <div class="cost-settings-actions">
      <button type="button" class="btn btn-primary" id="costSaveSettings">
        <i class="fas fa-save"></i> Salvar padrões
      </button>
      <span class="cost-hint" id="costSettingsStatus"></span>
    </div>
  </div>

  <!-- Entradas da peça -->
  <h4 class="cost-section-title">A peça</h4>
  <div class="cost-fields-grid">
    <label class="cost-field">
      <span>Filamento usado (g) <i class="fas fa-circle-info cost-tip" title="Peso final da peça. O suporte e a purga entram no desperdício abaixo."></i></span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_filament_grams" value="<%= cc.filament_grams || '' %>" placeholder="Ex: 85">
        <i class="cost-input-suffix">g</i>
      </span>
    </label>
    <label class="cost-field">
      <span>Horas de impressão <i class="fas fa-circle-info cost-tip" title="Tempo real de impressão, do início ao fim, conforme o fatiador."></i></span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_print_hours" value="<%= cc.print_hours || '' %>" placeholder="Ex: 3,5">
        <i class="cost-input-suffix">h</i>
      </span>
    </label>
    <label class="cost-field">
      <span>Desperdício / suporte (%)</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_material_waste_pct" value="<%= n2(cc.material_waste_pct, 0) %>">
        <i class="cost-input-suffix">%</i>
      </span>
    </label>
    <label class="cost-field">
      <span>Taxa de falha (%)</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="numeric" class="cost-input" id="c_failure_rate" value="<%= cc.failure_rate != null ? n2(cc.failure_rate) : '' %>" placeholder="<%= n2(sv.failure_rate, 10) %>">
        <i class="cost-input-suffix">%</i>
      </span>
    </label>
  </div>

  <h4 class="cost-section-title">Acabamento <small>opcional</small></h4>
  <div class="cost-fields-grid">
    <label class="cost-field">
      <span>Horas de acabamento</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_labor_hours" value="<%= n2(cc.labor_hours, 0) %>">
        <i class="cost-input-suffix">h</i>
      </span>
    </label>
    <label class="cost-field">
      <span>Valor da hora (R$)</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_labor_rate" value="<%= n2(cc.labor_rate, 0) %>">
        <i class="cost-input-suffix">R$/h</i>
      </span>
    </label>
  </div>

  <h4 class="cost-section-title">Outros custos <small>opcional</small></h4>
  <p class="cost-hint cost-hint-block">Deixe em branco para usar o valor fixo. Preencha para customizar só nesta peça.</p>
  <%
    /* O banco guarda o valor JÁ RESOLVIDO (ex.: 3,00 do padrão da loja) mais a
       flag use_custom_*. Usar isBlank() aqui mostraria o padrão como se fosse
       customization, e salvar fixaria o valor antigo para sempre neste produto,
       ignorando future changes nos padrões da loja. */
    const packCustom = !!(standalone ? 0 : cc.use_custom_packaging);
    const addCustom = !!(standalone ? 0 : cc.use_custom_additional);
  %>
  <div class="cost-fields-grid">
    <label class="cost-field">
      <span>Embalagem (R$)</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_packaging_cost" value="<%= packCustom ? cc.packaging_cost : '' %>" placeholder="padrão <%= n2(sv.packaging_cost, 3) %>">
        <i class="cost-input-suffix">R$</i>
      </span>
    </label>
    <label class="cost-field">
      <span>Outros (R$)</span>
      <span class="cost-input-wrap">
        <input type="text" inputmode="decimal" class="cost-input" id="c_additional_cost" value="<%= addCustom ? cc.additional_cost : '' %>" placeholder="padrão <%= n2(sv.other_costs, 0) %>">
        <i class="cost-input-suffix">R$</i>
      </span>
    </label>
  </div>

  <!-- Resultado -->
  <div class="cost-result" id="costResult">
    <div class="cost-result-main">
      <span class="cost-result-label">Custo real por peça</span>
      <strong id="r_total">R$ 0,00</strong>
      <span class="cost-result-note" id="r_profitNote">Informe filamento e horas para calcular</span>
    </div>
    <div class="cost-result-grid">
      <div class="cost-chips">
        <div class="cost-chip"><span>Material</span><b id="r_material">R$ 0,00</b></div>
        <div class="cost-chip"><span>Máquina</span><b id="r_machine">R$ 0,00</b></div>
        <div class="cost-chip"><span>Mão de obra</span><b id="r_labor">R$ 0,00</b></div>
        <div class="cost-chip"><span>Embalagem + extras</span><b id="r_extras">R$ 0,00</b></div>
      </div>
      <div class="cost-profit">
        <div class="cost-profit-row">
          <span>Lucro por peça</span>
          <b id="r_profit">R$ 0,00</b>
        </div>
        <div class="cost-profit-row">
          <span>Margem</span>
          <b id="r_margin">0%</b>
        </div>
      </div>
    </div>
    <p class="cost-hint cost-origin" id="r_origin"></p>
    <div class="cost-suggest">
      <div class="cost-suggest-input">
        <label class="cost-field cost-suggest-field" for="c_target_margin">
          <span>Margem de lucro desejada</span>
          <span class="cost-input-wrap">
            <input type="text" inputmode="numeric" id="c_target_margin" value="<%= mq %>">
            <i class="cost-input-suffix">%</i>
          </span>
        </label>
        <div class="cost-margin-presets" id="costMarginPresets">
          <button type="button" class="cost-preset" data-margin="20">20%</button>
          <button type="button" class="cost-preset" data-margin="30">30%</button>
          <button type="button" class="cost-preset" data-margin="40">40%</button>
          <button type="button" class="cost-preset" data-margin="50">50%</button>
          <button type="button" class="cost-preset" data-margin="60">60%</button>
        </div>
      </div>
      <div class="cost-suggest-out">
        <span>Venda sugerida</span>
        <strong id="r_suggested">R$ 0,00</strong>
        <small id="r_suggestedNote">para <%= mq %>% de lucro</small>
      </div>
    </div>
  </div>

  <% if (standalone) { %>
    <!-- Comparativo de margens -->
    <div class="cost-compare" id="costCompare" hidden>
      <h4 class="cost-section-title"><i class="fas fa-table"></i> Compare as margens</h4>
      <div class="cost-compare-scroll">
        <table class="cost-compare-table">
          <thead>
            <tr><th>Margem</th><th>Vender por</th><th>Lucro</th></tr>
          </thead>
          <tbody id="costCompareBody"></tbody>
        </table>
      </div>
      <p class="cost-hint">Valores já com a taxa de falha aplicada.</p>
    </div>
  <% } else { %>
    <div class="cost-actions">
      <button type="button" class="btn btn-primary" id="costApply">
        <i class="fas fa-check"></i> Aplicar custo em "Custo (R$)"
      </button>
      <p class="cost-hint" id="costStatus"></p>
    </div>
  <% } %>
</div>

<% if (!standalone) { %>
  </div>
<% } %>
