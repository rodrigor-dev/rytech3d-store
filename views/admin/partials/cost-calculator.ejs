<%
  /* Partial da calculadora de custo 3D.
     Locais aceitos:
       costSettings  – valores fixos da loja
       machine       – resumo do custo/hora
       costData      – ficha salva do produto (opcional)
       isStandalone  – true na aba /admin/calculator
       products      – produtos cadastrados (só na aba avulsa)
       history       – histórico de cálculos (só na aba avulsa) */
  const cc = costData || {};
  const sv = costSettings || {};
  const mach = machine || {};
  const standalone = (typeof isStandalone !== 'undefined' && isStandalone) ? true : false;
  const prodList = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];
  const histList = (typeof history !== 'undefined' && Array.isArray(history)) ? history : [];
  const n2 = (v, f) => { if (v === null || v === undefined || v === '') v = (f || 0); const x = Number(v); return (isFinite(x) ? x : (f || 0)).toFixed(2).replace('.', ','); };
  const nInt = (v, f) => { if (v === null || v === undefined || v === '') v = (f || 0); const x = Number(v); return String(Math.round(isFinite(x) ? x : (f || 0))); };
  const mq = (typeof margin !== 'undefined' && margin !== null && margin !== '') ? margin : (Number(sv.default_margin) || 40);
  const perGram = Number(sv.filament_price) > 0 ? (Number(sv.filament_price) / 1000) : 0;
  const hasSheet = !!(cc && Object.keys(cc).length);
  /* O banco guarda o valor JÁ RESOLVIDO (ex.: 3,00 do padrão da loja) mais a
     flag use_custom_*. Usar isBlank() aqui mostraria o padrão como se fosse
     customização, e salvar fixaria o valor antigo para sempre neste produto. */
  const packCustom = hasSheet && !!cc.use_custom_packaging;
  const addCustom = hasSheet && !!cc.use_custom_additional;
  const b = (v) => 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>

<% if (standalone) { %>
  <!-- Cabeçalho da página -->
  <div class="calc-hero">
    <div class="calc-hero-text">
      <span class="calc-hero-badge"><i class="fas fa-calculator"></i> Precificação de produção</span>
      <h1>Calculadora de Custo 3D</h1>
      <p>Descubra o custo real de cada peça, aplique no produto cadastrado ou guarde o cálculo de uma peça ainda não lançada.</p>
    </div>
    <div class="calc-hero-actions">
      <button type="button" class="btn btn-outline" id="costEditSettings">
        <i class="fas fa-sliders-h"></i> <span>Valores da produção</span>
      </button>
    </div>
  </div>
<% } else { %>
  <div class="cost-calc" id="costCalc">
    <button type="button" class="cost-calc-toggle" id="costCalcToggle" aria-expanded="<%= hasSheet ? 'true' : 'false' %>">
      <span class="cost-calc-toggle-icon"><i class="fas fa-calculator"></i></span>
      <span class="cost-calc-toggle-text">
        <strong>Calculadora de Custo de Produção</strong>
        <small>Descubra o custo real e o lucro de cada peça</small>
      </span>
      <i class="fas fa-chevron-down cost-calc-chevron"></i>
    </button>
<% } %>

<div class="cost-calc-panel" id="costCalcPanel" <%= (!standalone && !hasSheet) ? 'hidden' : '' %>>

  <% if (standalone) { %>
    <div class="calc-panel-head">
      <h2><i class="fas fa-list-check"></i> Preencha em 3 etapas e veja o resultado</h2>
      <button type="button" class="btn btn-outline btn-small" id="costEditSettingsMobile">
        <i class="fas fa-pen"></i> Valores fixos
      </button>
    </div>
  <% } %>

  <!-- ETAPA 0 (só avulsa): para onde vai o cálculo -->
  <% if (standalone) { %>
  <section class="calc-step calc-step-target">
    <div class="calc-step-head">
      <span class="calc-step-num">1</span>
      <div>
        <h3>Para onde vai este cálculo?</h3>
        <p>Escolha um produto que já está cadastrado para gravar o custo nele, ou dê um nome para uma peça que ainda não existe.</p>
      </div>
    </div>

    <div class="calc-target" role="radiogroup" aria-label="Destino do cálculo">
      <label class="calc-target-opt">
        <input type="radio" name="costTarget" value="product" id="costTargetProduct" <%= standalone ? '' : '' %>>
        <span class="calc-target-card">
          <i class="fas fa-box"></i>
          <b>Produto cadastrado</b>
          <small>Aplica e salva o custo no produto selecionado</small>
        </span>
      </label>
      <label class="calc-target-opt">
        <input type="radio" name="costTarget" value="draft" id="costTargetDraft" checked>
        <span class="calc-target-card">
          <i class="fas fa-pen-to-square"></i>
          <b>Peça não cadastrada</b>
          <small>Dê um nome e guarde no histórico</small>
        </span>
      </label>
    </div>

    <div class="calc-target-fields" id="costProductField" hidden>
      <label class="calc-label" for="costProductSelect">Produto</label>
      <div class="calc-select-wrap">
        <select id="costProductSelect">
          <option value="">Selecione um produto…</option>
          <% prodList.forEach((p) => { %>
            <option value="<%= p.id %>"><%= p.name %><%= Number(p.cost_price) > 0 ? '  (custo atual ' + b(p.cost_price) + ')' : '' %></option>
          <% }); %>
        </select>
        <i class="fas fa-chevron-down calc-select-icon"></i>
      </div>
      <p class="calc-help" id="costProductHelp">
        <i class="fas fa-circle-info"></i>
        Escolha o produto e a ficha de custo salva nele é carregada automaticamente, se existir.
      </p>
    </div>

    <div class="calc-target-fields" id="costDraftField">
      <label class="calc-label" for="costDraftName">Nome do produto</label>
      <input type="text" id="costDraftName" placeholder="Ex: Suporte de Monitor 3D" maxlength="160" autocomplete="off">
      <p class="calc-help">
        <i class="fas fa-circle-info"></i>
        Este cálculo fica salvo no histórico, mesmo que a peça não exista ainda no catálogo.
      </p>
    </div>
  </section>
  <% } %>

  <!-- ETAPA: a peça -->
  <section class="calc-step">
    <div class="calc-step-head">
      <span class="calc-step-num"><%= standalone ? '2' : '1' %></span>
      <div>
        <h3>A peça</h3>
        <p>Quanto de filamento a peça usa e quanto tempo leva para imprimir.</p>
      </div>
    </div>
    <div class="calc-fields-grid">
      <label class="calc-field">
        <span class="calc-label">Filamento usado (g)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_filament_grams" value="<%= cc.filament_grams || '' %>" placeholder="Ex: 85">
          <i class="calc-suffix">g</i>
        </span>
        <small class="calc-tip">Peso final da peça. Suporte e purga entram no desperdício abaixo.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Horas de impressão</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_print_hours" value="<%= cc.print_hours || '' %>" placeholder="Ex: 3,5">
          <i class="calc-suffix">h</i>
        </span>
        <small class="calc-tip">Tempo real do início ao fim, conforme o fatiador.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Desperdício / suporte (%)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_material_waste_pct" value="<%= n2(cc.material_waste_pct, 0) %>" placeholder="0">
          <i class="calc-suffix">%</i>
        </span>
        <small class="calc-tip">Bicos, brim, purge e peças que falham no suporte.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Taxa de falha (%)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="numeric" class="cost-input" id="c_failure_rate" value="<%= cc.failure_rate != null ? n2(cc.failure_rate) : '' %>" placeholder="<%= n2(sv.failure_rate, 10) %>">
          <i class="calc-suffix">%</i>
        </span>
        <small class="calc-tip">Em branco usa o padrão da loja (<%= n2(sv.failure_rate, 10) %>%). Repete a peça para recuperar o custo.</small>
      </label>
    </div>
  </section>

  <!-- ETAPA: acabamento e outros -->
  <section class="calc-step">
    <div class="calc-step-head">
      <span class="calc-step-num"><%= standalone ? '3' : '2' %></span>
      <div>
        <h3>Acabamento e outros custos <em>opcional</em></h3>
        <p>Lixamento, pintura, embalagem e o que mais entrar na conta.</p>
      </div>
    </div>
    <div class="calc-fields-grid">
      <label class="calc-field">
        <span class="calc-label">Horas de acabamento</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_labor_hours" value="<%= n2(cc.labor_hours, 0) %>" placeholder="0">
          <i class="calc-suffix">h</i>
        </span>
        <small class="calc-tip">Lixar, pintar, remover suportes.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Valor da sua hora (R$)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_labor_rate" value="<%= n2(cc.labor_rate, 0) %>" placeholder="<%= n2(sv.labor_rate, 0) %>">
          <i class="calc-suffix">R$/h</i>
        </span>
        <small class="calc-tip">Em branco usa o padrão da loja.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Embalagem (R$)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_packaging_cost" value="<%= packCustom ? cc.packaging_cost : '' %>" placeholder="padrão <%= n2(sv.packaging_cost, 3) %>">
          <i class="calc-suffix">R$</i>
        </span>
        <small class="calc-tip">Caixa, sacola, fita. Vazio = padrão da loja.</small>
      </label>
      <label class="calc-field">
        <span class="calc-label">Outros custos (R$)</span>
        <span class="calc-input-wrap">
          <input type="text" inputmode="decimal" class="cost-input" id="c_additional_cost" value="<%= addCustom ? cc.additional_cost : '' %>" placeholder="padrão <%= n2(sv.other_costs, 0) %>">
          <i class="calc-suffix">R$</i>
        </span>
        <small class="calc-tip">Adubo, cavo, rótulo, tudo que não seja a peça em si. Vazio = padrão da loja.</small>
      </label>
    </div>
  </section>

  <!-- Máquina: leitura dos valores fixos -->
  <div class="calc-machine" id="costMachineBar">
    <div class="calc-machine-head">
      <i class="fas fa-print"></i>
      <span>Sua impressora</span>
      <% if (!standalone) { %>
        <button type="button" class="cost-link-btn" id="costEditSettings">Ajustar valores</button>
      <% } %>
    </div>
    <div class="calc-machine-grid">
      <div><b id="mWattage"><%= nInt(mach.wattage, 0) %></b><span>watts</span></div>
      <div><b id="mHourly"><%= n2(mach.hourly) %></b><span>R$/hora</span></div>
      <div><b id="mDep"><%= n2(mach.depreciation) %></b><span>depreciação/h</span></div>
      <div><b id="mEnergy"><%= n2(mach.energy) %></b><span>energia/h</span></div>
    </div>
  </div>

  <!-- Configurações globais (recolhível) -->
  <div class="cost-settings-box" id="costSettingsBox" hidden>
    <h4><i class="fas fa-sliders-h"></i> Valores fixos da produção</h4>
    <p class="cost-hint">Use os valores da sua conta de luz e da sua impressora. Ficam salvos e valem para todos os produtos.</p>
    <div class="cost-settings-grid">
      <label class="cost-field">
        <span>Tarifa de energia (R$/kWh)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_energy_rate" value="<%= n2(sv.energy_rate, 1.13) %>">
          <i class="cost-input-suffix">R$/kWh</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Consumo da impressora (W)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_printer_watts" value="<%= nInt(sv.printer_watts, 180) %>">
          <i class="cost-input-suffix">watts</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Investimento na impressora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_printer_price" value="<%= n2(sv.printer_price, 5500) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Vida útil da impressora</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_printer_life_hours" value="<%= nInt(sv.printer_life_hours, 15000) %>">
          <i class="cost-input-suffix">horas</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Manutenção por hora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_maintenance_hourly" value="<%= n2(sv.maintenance_hourly, 0.05) %>">
          <i class="cost-input-suffix">R$/h</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Preço do filamento (carretel 1kg)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_filament_price" value="<%= n2(sv.filament_price, 130) %>">
          <i class="cost-input-suffix">R$/kg</i>
        </span>
        <small class="cost-unit-hint">equivale a <b id="s_filament_pergram"><%= b(perGram) %></b> por grama</small>
      </label>
      <label class="cost-field">
        <span>Embalagem (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_packaging_cost" value="<%= n2(sv.packaging_cost, 3) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Outros custos fixos (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_other_costs" value="<%= n2(sv.other_costs, 0) %>">
          <i class="cost-input-suffix">R$</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Taxa de falha padrão (%)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_failure_rate" value="<%= n2(sv.failure_rate, 10) %>">
          <i class="cost-input-suffix">%</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Valor da minha hora (R$)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="decimal" id="s_labor_rate" value="<%= n2(sv.labor_rate, 0) %>">
          <i class="cost-input-suffix">R$/h</i>
        </span>
      </label>
      <label class="cost-field">
        <span>Margem de lucro padrão (%)</span>
        <span class="cost-input-wrap">
          <input type="text" inputmode="numeric" id="s_default_margin" value="<%= nInt(sv.default_margin, 40) %>">
          <i class="cost-input-suffix">%</i>
        </span>
      </label>
    </div>
    <div class="cost-settings-actions">
      <button type="button" class="btn btn-primary" id="costSaveSettings">
        <i class="fas fa-save"></i> Salvar padrões
      </button>
      <span class="cost-hint" id="costSettingsStatus"></span>
    </div>
  </div>

  <!-- RESULTADO -->
  <section class="calc-result" id="costResult">
    <div class="calc-result-top">
      <div>
        <span class="calc-result-step"><%= standalone ? '4' : '3' %> &#183; resultado</span>
        <span class="calc-result-label">Custo real por peça</span>
        <strong class="calc-result-total" id="r_total">R$ 0,00</strong>
        <span class="calc-result-note" id="r_profitNote">Preencha as etapas acima para calcular</span>
      </div>
    </div>

    <div class="calc-breakdown" id="r_breakdown">
      <div class="calc-chip"><span>Material</span><b id="r_material">R$ 0,00</b></div>
      <div class="calc-chip"><span>Máquina</span><b id="r_machine">R$ 0,00</b></div>
      <div class="calc-chip"><span>Acabamento</span><b id="r_labor">R$ 0,00</b></div>
      <div class="calc-chip"><span>Embalagem + extras</span><b id="r_extras">R$ 0,00</b></div>
    </div>

    <div class="calc-margin-row">
      <div class="calc-profit">
        <span>Lucro por peça</span>
        <b id="r_profit">—</b>
      </div>
      <div class="calc-profit">
        <span>Margem atual</span>
        <b id="r_margin">—</b>
      </div>
    </div>

    <p class="cost-hint cost-origin" id="r_origin"></p>

    <div class="calc-suggest">
      <div class="calc-suggest-input">
        <label class="calc-field" for="c_target_margin">
          <span class="calc-label">Margem de lucro desejada</span>
          <span class="calc-input-wrap">
            <input type="text" inputmode="numeric" id="c_target_margin" value="<%= mq %>">
            <i class="calc-suffix">%</i>
          </span>
        </label>
        <div class="calc-presets" id="costMarginPresets">
          <% [20, 30, 40, 50, 60].forEach((p) => { %>
            <button type="button" class="calc-preset" data-margin="<%= p %>"><%= p %>%</button>
          <% }); %>
        </div>
      </div>
      <div class="calc-suggest-out">
        <span>Venda sugerida</span>
        <strong id="r_suggested">R$ 0,00</strong>
        <small id="r_suggestedNote">para <%= mq %>% de lucro</small>
      </div>
    </div>
  </section>

  <% if (standalone) { %>
    <!-- AÇÃO: salvar -->
    <div class="calc-actions">
      <button type="button" class="btn btn-primary btn-lg" id="costSaveCalc">
        <i class="fas fa-check" id="costSaveCalcIcon"></i> <span id="costSaveCalcLabel">Salvar cálculo</span>
      </button>
      <p class="cost-hint" id="costStatus"></p>
    </div>

    <!-- Comparativo de margens -->
    <section class="calc-compare" id="costCompare" hidden>
      <h4 class="calc-section-title"><i class="fas fa-table"></i> Compare as margens</h4>
      <p class="calc-help">Preço de venda para cada margem, já com a taxa de falha aplicada. Use como referência na hora de cadastrar o produto.</p>
      <div class="calc-compare-scroll">
        <table class="calc-compare-table">
          <thead><tr><th>Margem</th><th>Vender por</th><th>Lucro</th></tr></thead>
          <tbody id="costCompareBody"></tbody>
        </table>
      </div>
    </section>

    <!-- Histórico -->
    <section class="calc-history" id="costHistory">
      <div class="calc-history-head">
        <h4 class="calc-section-title"><i class="fas fa-clock-rotate-left"></i> Histórico</h4>
        <span class="calc-history-count" id="costHistoryCount"><%= histList.length %></span>
      </div>
      <p class="calc-help">Cálculos que você salvou. Clique em <b>Recarregar</b> para trazer os valores de volta ao formulário.</p>
      <div class="calc-history-list" id="costHistoryList">
        <% if (!histList.length) { %>
          <p class="calc-empty" id="costHistoryEmpty">
            <i class="fas fa-inbox"></i>
            Nenhum cálculo salvo ainda. Preencha as etapas e toque em <b>Salvar cálculo</b>.
          </p>
        <% } else { %>
          <% histList.forEach((c) => { %>
            <article class="calc-history-item" data-id="<%= c.id %>"
              data-product-id="<%= c.product_id || '' %>"
              data-name="<%= c.product_name %>"
              data-origin="<%= c.origin %>"
              data-grams="<%= c.filament_grams %>"
              data-hours="<%= c.print_hours %>"
              data-waste="<%= c.material_waste_pct %>"
              data-failure="<%= c.failure_rate %>"
              data-labor-h="<%= c.labor_hours %>"
              data-labor-rate="<%= c.labor_rate %>"
              data-packaging="<%= c.packaging_cost %>"
              data-packaging-custom="<%= c.use_custom_packaging ? 1 : 0 %>"
              data-additional="<%= c.additional_cost %>"
              data-additional-custom="<%= c.use_custom_additional ? 1 : 0 %>"
              data-margin="<%= c.target_margin %>"
              data-sale="<%= c.sale_price %>">
              <div class="calc-history-main">
                <b><%= c.product_name %></b>
                <small>
                  <% if (c.origin === 'product') { %>
                    <i class="fas fa-box"></i> produto cadastrado
                  <% } else { %>
                    <i class="fas fa-pen-to-square"></i> peça avulsa
                  <% } %>
                  · <%= n2(c.filament_grams, 0) %> g · <%= n2(c.print_hours, 0) %> h · <%= n2(c.target_margin, 0) %>% margem
                </small>
              </div>
              <div class="calc-history-values">
                <b><%= b(c.total_cost) %></b>
                <small>vender por <%= b(c.suggested_price) %></small>
              </div>
              <div class="calc-history-btns">
                <button type="button" class="calc-icon-btn" data-act="reload" title="Recarregar no formulário">
                  <i class="fas fa-rotate-left"></i><span>Recarregar</span>
                </button>
                <button type="button" class="calc-icon-btn is-danger" data-act="delete" title="Remover do histórico">
                  <i class="fas fa-trash"></i><span>Excluir</span>
                </button>
              </div>
            </article>
          <% }); %>
        <% } %>
      </div>
    </section>
  <% } else { %>
    <div class="cost-actions">
      <button type="button" class="btn btn-primary" id="costApply">
        <i class="fas fa-check"></i> Aplicar custo em "Custo (R$)"
      </button>
      <p class="cost-hint" id="costStatus"></p>
    </div>
  <% } %>
</div>

<% if (!standalone) { %>
  </div>
<% } %>
