<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Admin RYTECH3D</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-layout">
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">
          <span class="logo-text">RYTECH<span class="logo-highlight">3D</span></span>
        </a>
      </div>
      <nav class="sidebar-nav">
        <a href="/admin" class="sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>">
          <i class="fas fa-chart-bar"></i> <span>Dashboard</span>
        </a>
        <a href="/admin/products" class="sidebar-link <%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">
          <i class="fas fa-cube"></i> <span>Produtos</span>
        </a>
        <a href="/admin/orders" class="sidebar-link <%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">
          <i class="fas fa-shopping-cart"></i> <span>Pedidos</span>
        </a>
        <a href="/admin/customers" class="sidebar-link <%= currentPath === '/admin/customers' ? 'active' : '' %>">
          <i class="fas fa-users"></i> <span>Clientes</span>
        </a>
        <a href="/admin/admins" class="sidebar-link <%= currentPath === '/admin/admins' ? 'active' : '' %>">
          <i class="fas fa-user-shield"></i> <span>Admins</span>
        </a>
        <a href="/admin/settings" class="sidebar-link <%= currentPath === '/admin/settings' ? 'active' : '' %>">
          <i class="fas fa-cog"></i> <span>Configurações</span>
        </a>
        <a href="/admin/finances" class="sidebar-link <%= currentPath === '/admin/finances' ? 'active' : '' %>">
          <i class="fas fa-dollar-sign"></i> <span>Finanças</span>
        </a>
        <hr>
        <a href="/" class="sidebar-link" target="_blank">
          <i class="fas fa-external-link-alt"></i> <span>Ver Site</span>
        </a>
        <a href="/admin/logout" class="sidebar-link">
          <i class="fas fa-sign-out-alt"></i> <span>Sair</span>
        </a>
        <div class="sidebar-user">
          <div class="user-avatar"><%= (adminUser?.username || 'A').charAt(0).toUpperCase() %></div>
          <div class="user-info">
            <span class="user-name"><%= adminUser?.username || 'Admin' %></span>
            <span class="user-role">Administrador</span>
          </div>
        </div>
      </nav>
    </aside>
    <main class="admin-main">
