<%- include('partials/header', { title: 'Finanças' }) %>

<style>
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; }
.modal-overlay.active { display: flex; }
.modal-box { background: var(--bg-primary); border-radius: var(--radius); padding: 28px; width: 90%; max-width: 480px; border: 1px solid var(--border); }
.modal-box h3 { margin: 0 0 16px; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
.btn-icon { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); cursor: pointer; transition: 0.2s; }
.btn-icon:hover { background: var(--accent); color: #000; border-color: var(--accent); }
</style>

<div class="admin-content">
  <h1>Finanças</h1>

  <% if (error) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>

  <div class="finance-summary">
    <div class="finance-card">
      <div class="label">Receitas</div>
      <div class="value positive">R$ <%= totalRevenue.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Despesas</div>
      <div class="value negative">R$ <%= totalExpenses.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Saldo</div>
      <div class="value <%= (totalRevenue - totalExpenses) >= 0 ? 'positive' : 'negative' %>">R$ <%= (totalRevenue - totalExpenses).toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Vendas (Pedidos)</div>
      <div class="value positive">R$ <%= orderTotals.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card" style="border-color: rgba(255,159,28,0.3);">
      <div class="label">Cancelados</div>
      <div class="value" style="color:#ff9f1c">R$ <%= totalCancelled.toFixed(2).replace('.', ',') %></div>
      <div style="font-size:0.8rem;color:var(--text-muted);margin-top:4px">
        <%= cancelledCount %> pedido<%= cancelledCount !== 1 ? 's' : '' %> (<%= cancelRate.toFixed(1) %>%)
      </div>
    </div>
  </div>

  <h2 style="margin-top:32px">Análise de Lucro</h2>
  <div class="finance-summary">
    <div class="finance-card">
      <div class="label">Receita de Pedidos</div>
      <div class="value positive">R$ <%= profitTotalRevenue.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Custo dos Pedidos</div>
      <div class="value negative">R$ <%= profitTotalCost.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Lucro Bruto</div>
      <div class="value <%= profitAmount >= 0 ? 'positive' : 'negative' %>">R$ <%= profitAmount.toFixed(2).replace('.', ',') %></div>
    </div>
    <div class="finance-card">
      <div class="label">Margem</div>
      <div class="value <%= profitMargin >= 0 ? 'positive' : 'negative' %>"><%= profitMargin.toFixed(2).replace('.', ',') %>%</div>
    </div>
  </div>

  <% if (mostProfitable && mostProfitable.length > 0) { %>
  <div class="admin-card" style="margin-top:16px">
    <div class="admin-card-header">
      <h2>Produtos Mais Lucrativos</h2>
    </div>
    <div class="admin-card-body" style="overflow-x:auto">
      <table class="finance-table">
        <thead>
          <tr>
            <th>Produto</th>
            <th>Qtd.</th>
            <th>Receita</th>
            <th>Custo</th>
            <th>Lucro</th>
            <th>Margem</th>
          </tr>
        </thead>
        <tbody>
          <% mostProfitable.forEach(p => {
            const pMargin = p.total_revenue > 0 ? (p.total_profit / p.total_revenue * 100) : 0;
            const pClass = p.total_profit > 0 ? 'profit-positive' : (p.total_profit < 0 ? 'profit-negative' : '');
          %>
            <tr>
              <td><%= p.product_name %></td>
              <td><%= p.total_quantity %></td>
              <td>R$ <%= p.total_revenue.toFixed(2).replace('.', ',') %></td>
              <td>R$ <%= p.total_cost.toFixed(2).replace('.', ',') %></td>
              <td class="<%= pClass %>">R$ <%= p.total_profit.toFixed(2).replace('.', ',') %></td>
              <td class="<%= pClass %>"><%= pMargin.toFixed(2).replace('.', ',') %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <div class="finance-nav">
    <form method="GET" action="/admin/finances" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <label style="font-size:0.85rem;color:var(--text-muted)">Filtrar por período:</label>
      <input type="date" name="start_date" value="<%= startDate %>" style="width:auto">
      <span style="color:var(--text-muted)">até</span>
      <input type="date" name="end_date" value="<%= endDate %>" style="width:auto">
      <button type="submit" class="btn btn-small btn-primary"><i class="fas fa-filter"></i> Filtrar</button>
      <a href="/admin/finances" class="btn btn-small btn-outline"><i class="fas fa-undo"></i> Limpar</a>
    </form>
    <div style="flex:1"></div>
    <button class="btn btn-primary btn-small" onclick="openAddModal()"><i class="fas fa-plus"></i> Nova Transação</button>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <h2>Transações</h2>
      <span style="font-size:0.85rem;color:var(--text-muted)">
        <% if (startDate && endDate) { %>
          <%= new Date(startDate).toLocaleDateString('pt-BR') %> — <%= new Date(endDate).toLocaleDateString('pt-BR') %>
        <% } else { %>
          Todos os registros
        <% } %>
      </span>
    </div>
    <div class="admin-card-body" style="overflow-x:auto">
      <% if (transactions.length === 0) { %>
        <div class="empty-state" style="padding:40px 0">
          <i class="fas fa-coins"></i>
          <h3>Nenhuma transação encontrada</h3>
          <p>Não há registros no período selecionado. Clique em "Nova Transação" para adicionar.</p>
        </div>
      <% } else { %>
        <table class="finance-table">
          <thead>
            <tr>
              <th>Data</th>
              <th>Tipo</th>
              <th>Categoria</th>
              <th>Descrição</th>
              <th>Valor</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(t => { %>
              <tr>
                <td><%= new Date(t.date).toLocaleDateString('pt-BR') %></td>
                <td><span class="tag <%= t.type === 'revenue' ? 'tag-revenue' : t.type === 'cancelled' ? 'tag-cancelled' : 'tag-expense' %>"><%= t.type === 'revenue' ? 'Receita' : t.type === 'cancelled' ? 'Cancelado' : 'Despesa' %></span></td>
                <td><%= t.category || '-' %></td>
                <td><%= t.description || '-' %></td>
                <td style="font-weight:600;color:<%= t.type === 'revenue' ? 'var(--accent)' : t.type === 'cancelled' ? '#ff9f1c' : 'var(--red)' %>">R$ <%= t.amount.toFixed(2).replace('.', ',') %></td>
                <td>
                  <button class="btn-icon" onclick='openEditModal(<%= JSON.stringify(t) %>)' title="Editar"><i class="fas fa-edit"></i></button>
                  <form method="POST" action="/admin/finances/delete/<%= t.id %>" style="display:inline" onsubmit="return confirm('Excluir esta transação?')">
                    <button class="btn-icon" style="border-color:transparent" title="Excluir"><i class="fas fa-trash" style="color:var(--red)"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
  <div class="modal-box">
    <h3>Nova Transação</h3>
    <form method="POST" action="/admin/finances/add">
      <div class="form-row">
        <div class="form-group">
          <label>Tipo *</label>
          <select name="type" class="form-control" required>
            <option value="revenue">Receita</option>
            <option value="expense">Despesa</option>
          </select>
        </div>
        <div class="form-group">
          <label>Categoria</label>
          <select name="category" class="form-control">
            <option value="">Selecione</option>
            <option value="order">Pedido</option>
            <option value="material">Material</option>
            <option value="energy">Energia</option>
            <option value="packaging">Embalagem</option>
            <option value="freight">Frete</option>
            <option value="maintenance">Manutenção</option>
            <option value="other">Outro</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Descrição</label>
        <input type="text" name="description" class="form-control">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Valor (R$) *</label>
          <input type="number" name="amount" step="0.01" min="0" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Data</label>
          <input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('addModal').classList.remove('active')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal-box">
    <h3>Editar Transação</h3>
    <form method="POST" id="editForm">
      <div class="form-row">
        <div class="form-group">
          <label>Tipo</label>
          <select name="type" class="form-control" id="editType" required>
            <option value="revenue">Receita</option>
            <option value="expense">Despesa</option>
          </select>
        </div>
        <div class="form-group">
          <label>Categoria</label>
          <select name="category" class="form-control" id="editCategory">
            <option value="">Selecione</option>
            <option value="order">Pedido</option>
            <option value="material">Material</option>
            <option value="energy">Energia</option>
            <option value="packaging">Embalagem</option>
            <option value="freight">Frete</option>
            <option value="maintenance">Manutenção</option>
            <option value="other">Outro</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Descrição</label>
        <input type="text" name="description" class="form-control" id="editDesc">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Valor (R$)</label>
          <input type="number" name="amount" step="0.01" min="0" class="form-control" id="editAmount" required>
        </div>
        <div class="form-group">
          <label>Data</label>
          <input type="date" name="date" class="form-control" id="editDate">
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('editModal').classList.remove('active')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<script>
function openAddModal() { document.getElementById('addModal').classList.add('active'); }
function openEditModal(t) {
  document.getElementById('editType').value = t.type;
  document.getElementById('editCategory').value = t.category || '';
  document.getElementById('editDesc').value = t.description || '';
  document.getElementById('editAmount').value = t.amount;
  document.getElementById('editDate').value = t.date;
  document.getElementById('editForm').action = '/admin/finances/edit/' + t.id;
  document.getElementById('editModal').classList.add('active');
}
document.querySelectorAll('.modal-overlay').forEach(el => {
  el.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('active'); });
});
</script>

<%- include('partials/footer') %>