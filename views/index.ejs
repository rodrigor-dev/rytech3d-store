<%- include('partials/header', { title: 'Início' }) %>

<% if (typeof featuredProducts !== 'undefined' && featuredProducts && featuredProducts.length > 0) { %>
<section class="section featured-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Destaques</span>
      <h2 class="section-title">Produtos em <span class="gradient-text">Destaque</span></h2>
    </div>
    <div class="featured-slider">
      <div class="featured-track" id="featuredTrack">
        <% featuredProducts.forEach(product => { %>
          <div class="featured-slide">
            <div class="product-card" data-id="<%= product.id %>">
              <div class="product-image">
                <img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy" onerror="this.src='/uploads/products/default.svg'">
                <span class="product-badge">Destaque</span>
                <div class="product-overlay">
                  <a href="/product/<%= product.id %>" class="btn btn-small btn-primary"><i class="fas fa-eye"></i> Detalhes</a>
                  <button class="btn btn-small btn-accent add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                    <i class="fas fa-cart-plus"></i>
                  </button>
                </div>
              </div>
              <div class="product-info">
                <span class="product-category"><%= product.category %></span>
                <h3 class="product-name"><%= product.name %></h3>
                <div class="product-delivery">
                  <i class="fas fa-clock"></i> <span><%= product.delivery_time %></span>
                </div>
                <div class="product-footer">
                  <span class="product-price">R$ <%= product.price.toFixed(2).replace('.', ',') %></span>
                  <button class="btn btn-sm btn-primary add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                    <i class="fas fa-cart-plus"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      <% if (featuredProducts.length > 3) { %>
      <button class="slider-btn slider-btn-prev" aria-label="Anterior"><i class="fas fa-chevron-left"></i></button>
      <button class="slider-btn slider-btn-next" aria-label="Próximo"><i class="fas fa-chevron-right"></i></button>
      <div class="slider-dots" id="sliderDots"></div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-text">
      <span class="hero-badge">Impressão 3D Profissional</span>
      <h1 class="hero-title">Transforme suas ideias em <span class="gradient-text">realidade</span></h1>
      <p class="hero-subtitle">Produtos personalizados impressos em 3D com alta qualidade e acabamento profissional. Cada peça é feita sob encomenda especialmente para você.</p>
      <div class="hero-actions">
        <a href="#produtos" class="btn btn-primary">
          <i class="fas fa-cube"></i> Ver Produtos
        </a>
        <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=<%= encodeURIComponent(siteSettings.whatsapp_message || 'Olá! Gostaria de fazer um pedido na RYTECH3D.') %>" target="_blank" class="btn btn-outline">
          <i class="fab fa-whatsapp"></i> Fale Conosco
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-3d-model">
        <div class="floating-cube">
          <div class="cube-face front"></div>
          <div class="cube-face back"></div>
          <div class="cube-face right"></div>
          <div class="cube-face left"></div>
          <div class="cube-face top"></div>
          <div class="cube-face bottom"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
      <path d="M0,50 C320,100 720,0 1440,50 L1440,100 L0,100 Z" fill="var(--bg-primary)"></path>
    </svg>
  </div>
</section>

<section class="section banner-section">
  <div class="container">
    <div class="banner-card">
      <div class="banner-content">
        <span class="banner-tag">Impressão 3D</span>
        <h2 class="banner-title">Peças <span class="gradient-text">Personalizadas</span></h2>
        <p class="banner-text">Do conceito à realidade. Transformamos suas ideias em objetos impressos em 3D com acabamento profissional.</p>
        <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=Olá! Quero fazer um orçamento personalizado." target="_blank" class="btn btn-accent">
          <i class="fab fa-whatsapp"></i> Solicitar Orçamento
        </a>
      </div>
      <div class="banner-visual">
        <i class="fas fa-cube"></i>
      </div>
    </div>
  </div>
</section>

<section class="section" id="produtos">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Nossos Produtos</span>
      <h2 class="section-title">Produtos <span class="gradient-text">Disponíveis</span></h2>
      <p class="section-desc">Todos os produtos são feitos sob encomenda com prazo de entrega informado.</p>
    </div>

    <div class="filter-bar">
      <div class="filter-categories">
        <a href="/#produtos" class="filter-btn <%= selectedCategory === 'Todos' || !selectedCategory ? 'active' : '' %>">Todos</a>
        <% categories.forEach(cat => { %>
          <a href="/?category=<%= encodeURIComponent(cat) %>#produtos" class="filter-btn <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
        <% }) %>
      </div>
      <form class="search-bar" action="/#produtos" method="GET">
        <i class="fas fa-search"></i>
        <input type="text" name="search" placeholder="Buscar produtos..." value="<%= search %>">
        <button type="submit" class="btn btn-small">Buscar</button>
      </form>
    </div>

    <% if (products.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-box-open"></i>
        <h3>Nenhum produto encontrado</h3>
        <p>Tente buscar por outra categoria ou termo.</p>
      </div>
    <% } %>

    <div class="products-grid">
      <% products.forEach(product => { %>
        <div class="product-card" data-id="<%= product.id %>">
          <div class="product-image">
            <img src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy" onerror="this.src='/uploads/products/default.svg'">
            <% if (product.featured) { %><span class="product-badge">Destaque</span><% } %>
            <div class="product-overlay">
              <a href="/product/<%= product.id %>" class="btn btn-small btn-primary"><i class="fas fa-eye"></i> Detalhes</a>
              <button class="btn btn-small btn-accent add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                <i class="fas fa-cart-plus"></i>
              </button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-category"><%= product.category %></span>
            <h3 class="product-name"><%= product.name %></h3>
            <div class="product-delivery">
              <i class="fas fa-clock"></i> <span><%= product.delivery_time %></span>
            </div>
            <div class="product-footer">
              <span class="product-price">R$ <%= product.price.toFixed(2).replace('.', ',') %></span>
              <button class="btn btn-sm btn-primary add-to-cart-btn" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-image="<%= product.image_url %>">
                <i class="fas fa-cart-plus"></i>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container">
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-cube"></i></div>
        <h3>Impressão 3D Profissional</h3>
        <p>Utilizamos filamentos de alta qualidade e impressoras modernas para garantir o melhor resultado.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-paint-brush"></i></div>
        <h3>Totalmente Personalizável</h3>
        <p>Cada produto é feito sob encomenda e pode ser personalizado conforme sua preferência.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-truck"></i></div>
        <h3>Prazo de Entrega</h3>
        <p>Produzimos com agilidade sem comprometer a qualidade. Consulte o prazo em cada produto.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
        <h3>Qualidade Garantida</h3>
        <p>Seu produto passa por controle de qualidade antes de ser enviado. Satisfação garantida!</p>
      </div>
    </div>
  </div>
</section>

<section class="section cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>Tem uma ideia em mente?</h2>
      <p>Quer um produto personalizado? Fale conosco no WhatsApp e faça seu orçamento sem compromisso!</p>
      <a href="https://wa.me/<%= siteSettings.whatsapp_number || '5562992371986' %>?text=<%= encodeURIComponent(siteSettings.whatsapp_message || 'Olá! Gostaria de fazer um pedido na RYTECH3D.') %>" target="_blank" class="btn btn-accent btn-lg">
        <i class="fab fa-whatsapp"></i> Fale Conosco no WhatsApp
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<style>
.featured-section { padding-top: 40px; padding-bottom: 20px; }
.featured-slider { position: relative; overflow: hidden; margin: 0 -8px; user-select: none; -webkit-user-select: none; touch-action: pan-y; }
.featured-track { display: flex; transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94); gap: 16px; cursor: grab; }
.featured-track.dragging { transition: none; cursor: grabbing; }
.featured-slide { flex: 0 0 calc(33.333% - 11px); min-width: 250px; }
.featured-slide .product-image { height: 240px; }
.featured-slide .product-info { padding: 14px; }
.featured-slide .product-name { font-size: 0.95rem; }
.featured-slide .product-price { font-size: 1.1rem; }
@media (max-width: 768px) {
  .featured-slide { flex: 0 0 calc(50% - 8px); min-width: 200px; }
  .featured-slide .product-image { height: 200px; }
}
@media (max-width: 480px) {
  .featured-slide { flex: 0 0 100%; min-width: 0; }
  .featured-track { gap: 0; }
  .featured-slide .product-image { height: 240px; }
  .featured-slide .product-info { padding: 14px 16px; }
  .featured-slide .product-name { font-size: 1rem; }
  .featured-slide .product-price { font-size: 1.15rem; }
  .featured-section { padding-top: 24px; padding-bottom: 12px; }
}
.slider-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; opacity: 0; box-shadow: var(--shadow); }
.featured-slider:hover .slider-btn, .slider-btn.visible { opacity: 1; }
.slider-btn:hover { background: var(--accent); color: #000; border-color: var(--accent); }
.slider-btn-prev { left: 4px; }
.slider-btn-next { right: 4px; }
@media (max-width: 768px) { .slider-btn { width: 34px; height: 34px; font-size: 0.85rem; opacity: 1; background: var(--bg-card); } }
.slider-dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
.slider-dot { width: 8px; height: 8px; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-secondary); cursor: pointer; transition: 0.2s; padding: 0; }
.slider-dot.active { background: var(--accent); border-color: var(--accent); }
@media (max-width: 480px) { .slider-dot { width: 10px; height: 10px; } }
</style>

<script>
(function() {
  var featuredIndex = 0;
  var visible = 3;

  function getVisible() {
    return window.innerWidth <= 480 ? 1 : window.innerWidth <= 768 ? 2 : 3;
  }

  function slideFeatured(dir) {
    var track = document.getElementById('featuredTrack');
    if (!track) return;
    var slides = track.querySelectorAll('.featured-slide');
    if (!slides.length) return;
    visible = getVisible();
    var max = Math.max(0, slides.length - visible);
    featuredIndex = Math.max(0, Math.min(max, featuredIndex + dir));
    track.style.transform = 'translateX(' + (-featuredIndex * (100 / visible)) + '%)';
    var dots = document.querySelectorAll('.slider-dot');
    dots.forEach(function(d, i) { d.classList.toggle('active', i === featuredIndex); });
  }

  window.slideFeatured = slideFeatured;

  document.addEventListener('DOMContentLoaded', function() {
    var track = document.getElementById('featuredTrack');
    if (!track) return;
    var slides = track.querySelectorAll('.featured-slide');
    if (!slides.length) return;
    visible = getVisible();

    var slider = document.querySelector('.featured-slider');
    if (slider) {
      slider.addEventListener('click', function(e) {
        var btn = e.target.closest('.slider-btn-prev');
        if (btn) { slideFeatured(-1); return; }
        btn = e.target.closest('.slider-btn-next');
        if (btn) { slideFeatured(1); return; }
      });
    }

    var dotsContainer = document.getElementById('sliderDots');
    if (dotsContainer) {
      var count = Math.max(0, slides.length - visible + 1);
      for (var i = 0; i < count; i++) {
        var dot = document.createElement('div');
        dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
        dot.addEventListener('click', (function(idx) {
          return function() { featuredIndex = idx; slideFeatured(0); };
        })(i));
        dotsContainer.appendChild(dot);
      }
    }

    var startX = 0, currentX = 0, isDragging = false, startPct = 0, trackWidth = 0;

    function getSlidePct() { return 100 / visible; }

    function onStart(clientX) {
      if (!slides.length) return;
      visible = getVisible();
      trackWidth = track.offsetWidth;
      var max = Math.max(0, slides.length - visible);
      featuredIndex = Math.max(0, Math.min(max, featuredIndex));
      startX = clientX;
      currentX = clientX;
      isDragging = true;
      startPct = featuredIndex * getSlidePct();
      track.classList.add('dragging');
      track.style.transition = 'none';
    }

    function onMove(clientX) {
      if (!isDragging || !trackWidth) return;
      currentX = clientX;
      var diffPct = ((startX - currentX) / trackWidth) * 100;
      var newPct = Math.max(0, Math.min((slides.length - visible) * getSlidePct(), startPct + diffPct));
      track.style.transform = 'translateX(' + (-newPct) + '%)';
    }

    function onEnd() {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('dragging');
      track.style.transition = '';
      var diffPct = ((startX - currentX) / trackWidth) * 100;
      if (Math.abs(diffPct) > getSlidePct() * 0.25) slideFeatured(diffPct > 0 ? 1 : -1);
      else slideFeatured(0);
    }

    track.addEventListener('touchstart', function(e) { onStart(e.touches[0].clientX); }, { passive: true });
    track.addEventListener('touchmove', function(e) { onMove(e.touches[0].clientX); }, { passive: true });
    track.addEventListener('touchend', onEnd, { passive: true });

    track.addEventListener('mousedown', function(e) { onStart(e.clientX); e.preventDefault(); });
    document.addEventListener('mousemove', function(e) { if (isDragging) { onMove(e.clientX); e.preventDefault(); } });
    document.addEventListener('mouseup', function() { if (isDragging) onEnd(); });

    window.addEventListener('resize', function() {
      visible = getVisible();
      slideFeatured(0);
    });
  });
})();
</script>
