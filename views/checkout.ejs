<%- include('partials/header', { title: 'Finalizar Pedido' }) %>

<style>
.checkout-item-variations { font-size: 0.8rem; color: var(--text-muted); margin: 2px 0 4px; }
.checkout-delivery-notice { display:flex; gap:12px; background:rgba(0,212,170,0.05); border:1px solid rgba(0,212,170,0.1); border-radius:var(--radius); padding:16px; margin-top:16px; align-items:flex-start; }
.checkout-delivery-notice i { font-size:1.5rem; color:var(--accent); margin-top:2px; }
.checkout-delivery-notice strong { display:block; margin-bottom:4px; font-size:0.95rem; }
.checkout-delivery-notice p { font-size:0.85rem; color:var(--text-secondary); margin:0; }
</style>
<section class="section checkout-section">
  <div class="container">
    <div class="checkout-container">
      <div class="checkout-main">
        <h1>Finalizar Pedido</h1>
        
        <% if (error) { %>
          <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <div class="checkout-card">
          <div class="checkout-card-header">
            <i class="fas fa-user"></i>
            <h2>Seus Dados</h2>
          </div>
          <div class="checkout-card-body">
            <div class="form-row">
              <div class="form-group">
                <label for="checkoutName">Nome Completo</label>
                <input type="text" id="checkoutName" class="form-control" value="<%= user.full_name %>">
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" class="form-control" value="<%= user.email %>" disabled>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="checkoutPhone">Telefone</label>
                <input type="text" id="checkoutPhone" class="form-control" value="<%= user.phone.replace(/(\d{2})(\d{4,5})(\d{4})/, '($1) $2-$3') %>" oninput="formatPhone(this)" maxlength="15">
              </div>
              <div class="form-group"></div>
            </div>
            <div class="checkout-delivery-notice">
              <i class="fas fa-truck"></i>
              <div>
                <strong>Entrega a Combinar</strong>
                <p>O prazo e a forma de entrega serão combinados diretamente com você após a confirmação do pedido.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="checkout-card">
          <div class="checkout-card-header">
            <i class="fas fa-box"></i>
            <h2>Itens do Pedido</h2>
          </div>
          <div class="checkout-card-body" id="checkoutItems">
            <div class="checkout-loading">Carregando itens do carrinho...</div>
          </div>
        </div>

        <div class="checkout-card">
          <div class="checkout-card-header">
            <i class="fas fa-sticky-note"></i>
            <h2>Observações</h2>
          </div>
          <div class="checkout-card-body">
            <textarea id="orderNotes" class="form-control" rows="3" placeholder="Alguma observação sobre o pedido? (opcional)"></textarea>
          </div>
        </div>
      </div>

      <div class="checkout-sidebar">
        <div class="checkout-summary">
          <h3>Resumo do Pedido</h3>
          <div id="summaryItems"></div>
          <hr>
          <div class="summary-total">
            <span>Total</span>
            <span id="summaryTotal">R$ 0,00</span>
          </div>
          <button class="btn btn-primary btn-block btn-lg" id="placeOrderBtn" onclick="placeOrder()">
            <i class="fas fa-check"></i> Confirmar Pedido
          </button>
          <p class="checkout-info"><i class="fas fa-info-circle"></i> Ao confirmar, você receberá a confirmação e iniciaremos a produção.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function renderCheckoutItems() {
  const cart = getCart();
  const container = document.getElementById('checkoutItems');
  const summaryItems = document.getElementById('summaryItems');
  const summaryTotal = document.getElementById('summaryTotal');
  
  if (cart.length === 0) {
    container.innerHTML = '<div class="empty-state"><i class="fas fa-shopping-cart"></i><h3>Carrinho vazio</h3><p>Adicione produtos ao carrinho primeiro.</p><a href="/" class="btn btn-primary">Ver Produtos</a></div>';
    document.getElementById('placeOrderBtn').disabled = true;
    summaryItems.innerHTML = '<p class="empty-summary">Nenhum item</p>';
    summaryTotal.textContent = 'R$ 0,00';
    return;
  }

  let html = '';
  let summaryHtml = '';
  let total = 0;

  cart.forEach((item, index) => {
    const subtotal = item.price * item.quantity;
    total += subtotal;
    const varsHtml = item.variations ? `<div class="checkout-item-variations">${Object.entries(item.variations).map(([k,v]) => k + ': ' + v.name).join(', ')}</div>` : '';
    html += `
      <div class="checkout-item">
        <img src="${item.image || '/uploads/products/default.svg'}" alt="${item.name}" onerror="this.src='/uploads/products/default.svg'">
        <div class="checkout-item-info">
          <h4>${item.product_name || item.name}</h4>
          ${varsHtml}
          <p>R$ ${item.price.toFixed(2).replace('.', ',')} x ${item.quantity} = R$ ${subtotal.toFixed(2).replace('.', ',')}</p>
        </div>
        <div class="checkout-item-total">R$ ${subtotal.toFixed(2).replace('.', ',')}</div>
      </div>
    `;
    const varsSummary = item.variations ? ' (' + Object.entries(item.variations).map(([k,v]) => k + ': ' + v.name).join(', ') + ')' : '';
    summaryHtml += `
      <div class="summary-item">
        <span>${item.product_name || item.name}${varsSummary} (${item.quantity}x)</span>
        <span>R$ ${subtotal.toFixed(2).replace('.', ',')}</span>
      </div>
    `;
  });

  container.innerHTML = html;
  summaryItems.innerHTML = summaryHtml;
  summaryTotal.textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
  document.getElementById('placeOrderBtn').disabled = false;
}

async function placeOrder() {
  const btn = document.getElementById('placeOrderBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...';

  const cart = getCart();
  if (cart.length === 0) {
    showToast('Carrinho vazio!');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-check"></i> Confirmar Pedido';
    return;
  }

  const notes = document.getElementById('orderNotes').value;
  const full_name = document.getElementById('checkoutName').value;
  const phone = document.getElementById('checkoutPhone').value;

  try {
    const response = await fetch('/place', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: cart, notes, full_name, phone })
    });

    const data = await response.json();

    if (data.success) {
      clearCart();
      window.location.href = '/confirmation/' + data.orderId;
    } else {
      showToast(data.error || 'Erro ao processar pedido');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-check"></i> Confirmar Pedido';
    }
  } catch (err) {
    showToast('Erro de conexão. Tente novamente.');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-check"></i> Confirmar Pedido';
  }
}

function formatPhone(input) {
  let v = input.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 2) v = '(' + v.substring(0, 2) + ') ' + v.substring(2);
  if (v.length > 10) v = v.substring(0, 10) + '-' + v.substring(10);
  else if (v.length > 8) v = v.substring(0, 8) + '-' + v.substring(8);
  input.value = v;
}

document.addEventListener('DOMContentLoaded', renderCheckoutItems);
</script>

<%- include('partials/footer') %>
